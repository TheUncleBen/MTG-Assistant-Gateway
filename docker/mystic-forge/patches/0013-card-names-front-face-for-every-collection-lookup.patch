+def _collection_name(name: str) -> str:
+    """The name POST /cards/collection finds a card by: the front face of a
+    two-part name. The lookup knows a split, adventure, modal double-faced or
+    transform card by its front face ("Fire", "Brazen Borrower") but answers
+    not_found for the full "Fire // Ice" (checked 2026-10-28), so every name
+    identifier goes through here. The card that comes back carries its full
+    name, and _card_name_aliases indexes it under each face as well, so a
+    line written either way finds it again."""
+    front = re.split(r"\s*//\s*", name, maxsplit=1)[0].strip()
+    return front or name.strip()
+
+
+async def _collection_lookup(
+    names: list[str],
+) -> tuple[dict[str, dict], list[str], list[str], list[str]]:
+    """Look card names up 75 at a time, each by _collection_name.
+
+    Returns (found, not_found, unchecked, errors): found maps each input name
+    (as given) to its card, not_found holds the input names Scryfall did not
+    know, unchecked the ones in a request that failed (never reported as
+    missing: a failed request says nothing about the card), errors the
+    failure texts. Every input name is in exactly one of the three.
+    """
+    unique = list(dict.fromkeys(n for n in names if n and n.strip()))
+    by_lookup: dict[str, list[str]] = {}
+    for name in unique:
+        by_lookup.setdefault(_collection_name(name).lower(), []).append(name)
+    lookups = list(dict.fromkeys(_collection_name(n) for n in unique))
+    found: dict[str, dict] = {}
+    not_found: list[str] = []
+    unchecked: list[str] = []
+    errors: list[str] = []
+    for batch in _chunk(lookups, 75):   # Scryfall's hard per-request cap
+        try:
+            data = await _scryfall_post(
+                "/cards/collection", {"identifiers": [{"name": n} for n in batch]})
+        except Exception as e:
+            unchecked.extend(n for b in batch for n in by_lookup.get(b.lower(), []))
+            errors.append(_scryfall_error(e))
+            continue
+        cards = data.get("data", [])
+        index = _index_collection_results(cards)
+        # Scryfall answers in identifier order, leaving out what it echoes
+        # in not_found; by position is the fallback for a card it answered
+        # under a name of its own that matches no face of the asked name.
+        missing = {str(i.get("name") or "").lower()
+                   for i in data.get("not_found", []) if isinstance(i, dict)}
+        answered = [b.lower() for b in batch if b.lower() not in missing]
+        by_position = dict(zip(answered, cards)) if len(answered) == len(cards) else {}
+        for asked in batch:
+            for name in by_lookup.get(asked.lower(), []):
+                card = (index.get(("name", name.lower().strip()))
+                        or index.get(("name", asked.lower()))
+                        or by_position.get(asked.lower()))
+                if card is not None:
+                    found[name] = card
+                else:
+                    not_found.append(name)
+    return found, not_found, unchecked, errors
+
