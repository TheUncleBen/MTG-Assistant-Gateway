@@ -0,0 +1,139 @@
+"""Two-part card names ("Fire // Ice") through every name lookup.
+
+Scryfall's POST /cards/collection knows a split, adventure, modal
+double-faced or transform card by its front face only: {"name": "Fire"}
+returns Fire // Ice, {"name": "Fire // Ice"} is not_found (checked
+2026-10-28). The fake below answers the same way.
+"""
+import server
+
+
+def _card(name, ci, faces=None, set_code="tst", number="1", **extra):
+    card = {"name": name, "color_identity": ci, "set": set_code,
+            "collector_number": number, "type_line": extra.pop("type_line", "Instant"),
+            "oracle_text": extra.pop("oracle_text", ""), "finishes": ["nonfoil"],
+            "prices": {"usd": "1.00"}, "games": ["paper"], "released_at": "2020-01-01",
+            **extra}
+    if faces:
+        card["card_faces"] = [{"name": f, "type_line": "Instant", "oracle_text": ""}
+                              for f in faces]
+    return card
+
+
+CARDS = [
+    _card("Fire // Ice", ["R", "U"], ["Fire", "Ice"], number="10"),  # split
+    _card("Wear // Tear", ["R", "W"], ["Wear", "Tear"], number="11"),  # split
+    _card("Brazen Borrower // Petty Theft", ["U"], ["Brazen Borrower", "Petty Theft"],
+          number="12"),  # adventure
+    _card("Delver of Secrets // Insectile Aberration", ["U"],
+          ["Delver of Secrets", "Insectile Aberration"], number="13"),  # transform
+    _card("Valki, God of Lies // Tibalt, Cosmic Impostor", ["B", "R"],
+          ["Valki, God of Lies", "Tibalt, Cosmic Impostor"], number="14"),  # modal DFC
+    _card("Lightning Bolt", ["R"], number="15"),
+    _card("Galadriel, Elven-Queen", ["G", "U"], number="16",
+          type_line="Legendary Creature — Elf Noble"),
+]
+
+
+def _by_collection_name(name):
+    """Scryfall's collection name match: a one-part card by its name, a
+    two-part card by a face, never by its full "A // B" name."""
+    for card in CARDS:
+        faces = [f["name"] for f in card.get("card_faces", [])]
+        names = faces[:1] if faces else [card["name"]]
+        if name.lower() in (n.lower() for n in names):
+            return card
+    return None
+
+
+def _install(monkeypatch, fail=False):
+    asked = []
+
+    async def post(endpoint, body):
+        assert endpoint == "/cards/collection"
+        asked.append(body["identifiers"])
+        if fail:
+            raise RuntimeError("down")
+        data, not_found = [], []
+        for ident in body["identifiers"]:
+            card = _by_collection_name(ident["name"]) if "name" in ident else None
+            (data.append(card) if card else not_found.append(ident))
+        return {"object": "list", "data": data, "not_found": not_found}
+
+    async def get(endpoint, params=None):
+        raise RuntimeError(f"unexpected GET {endpoint}")
+
+    monkeypatch.setattr(server, "_scryfall_post", post)
+    monkeypatch.setattr(server, "_scryfall_get", get)
+    monkeypatch.setattr(server, "_today", lambda: "2026-10-28")
+    return asked
+
+
+FULL = ["Fire // Ice", "Brazen Borrower // Petty Theft",
+        "Delver of Secrets // Insectile Aberration",
+        "Valki, God of Lies // Tibalt, Cosmic Impostor"]
+FRONT = ["Fire", "Brazen Borrower", "Delver of Secrets", "Valki, God of Lies"]
+
+
+def test_collection_name_is_the_front_face():
+    assert server._collection_name("Fire // Ice") == "Fire"
+    assert server._collection_name("Fire//Ice") == "Fire"
+    assert server._collection_name("Sol Ring") == "Sol Ring"
+
+
+async def test_card_text_finds_full_and_front_names(monkeypatch):
+    _install(monkeypatch)
+    for names in (FULL, FRONT):
+        out = await server.scryfall_card_text(
+            server.CardTextInput(cards="\n".join(names)))
+        assert "Not found" not in out, out
+        assert f"# Card Text ({len(names)} card(s))" in out
+
+
+async def test_card_text_not_found_names_what_was_written(monkeypatch):
+    _install(monkeypatch)
+    out = await server.scryfall_card_text(
+        server.CardTextInput(cards="Fire // Ice\nNotacard // Zzz"))
+    assert "## Not found (1)" in out
+    assert "- Notacard // Zzz" in out
+
+
+async def test_price_list_prices_full_names(monkeypatch):
+    _install(monkeypatch)
+    out = await server.scryfall_price_list(
+        server.PriceListInput(decklist="1 Fire // Ice\n1 Brazen Borrower // Petty Theft"))
+    assert "Not found" not in out, out
+    assert "(2 of 2 cards priced)" in out
+
+
+async def test_format_archidekt_full_name_is_found(monkeypatch):
+    _install(monkeypatch)
+    out = await server.format_archidekt(server.FormatDeckInput(cards=[
+        server.DeckCardEntry(name="Fire // Ice"),
+        server.DeckCardEntry(name="Delver of Secrets"),
+    ]))
+    assert "WARNING" not in out, out
+    assert "1x Fire // Ice" in out
+    assert "1x Delver of Secrets // Insectile Aberration" in out
+
+
+async def test_validate_decklist_flags_two_part_cards_outside_identity(monkeypatch):
+    _install(monkeypatch)
+    deck = "1 Fire // Ice\n1 Wear // Tear\n1 Fire\n1 Lightning Bolt\n1 Brazen Borrower"
+    out = await server.validate_decklist(server.ValidateDecklistInput(
+        decklist=deck, commander="Galadriel, Elven-Queen"))
+    assert "4 card(s) outside commander's color identity (G, U)" in out, out
+    for line in ("- Fire // Ice (has R)", "- Wear // Tear (has R, W)", "- Fire (has R)",
+                 "- Lightning Bolt (has R)"):
+        assert line in out
+    assert "Brazen Borrower (has" not in out
+    assert "not found" not in out
+
+
+async def test_validate_decklist_names_cards_it_could_not_check(monkeypatch):
+    _install(monkeypatch, fail=True)
+    out = await server.validate_decklist(server.ValidateDecklistInput(
+        decklist="1 Fire // Ice\n1 Sol Ring", commander="Galadriel, Elven-Queen"))
+    assert "Validation: ISSUES FOUND" in out
+    assert "2 card(s) could not be checked" in out
+    assert "  - Fire // Ice" in out and "  - Sol Ring" in out
