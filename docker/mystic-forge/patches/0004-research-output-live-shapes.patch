+async def test_annotate_finds_double_faced_cards_by_full_name(monkeypatch):
+    by_front = {c["name"].split(" // ")[0]: c for c in [*MINI_SCRYFALL, ENDURING]}
+    sent: list[str] = []
+
+    async def fake_post(path, body):
+        data, not_found = [], []
+        for ident in body["identifiers"]:
+            sent.append(ident["name"])
+            # as live: the full "Front // Back" name is not found, the front face is
+            card = by_front.get(ident["name"])
+            (data.append(card) if card else not_found.append(ident))
+        return {"data": data, "not_found": not_found}
+
+    monkeypatch.setattr(server, "_scryfall_post", fake_post)
+    monkeypatch.setattr(server, "_GOLDFISH_CARD_CACHE", {})
+    deck = ("1 Boss\n1 Enduring Angel // Angelic Enforcer (mid) 17 [Creature]\n"
+            "2 Bera\n30 Plains\n30 Mountain\n36 Bear")
+    out = await server.goldfish_annotate(server.GoldfishAnnotateInput(deck=deck))
+    assert "Enduring Angel // Angelic Enforcer" not in out.split("## Auto-derived")[0]
+    assert "Enduring Angel // Angelic Enforcer" in out
+    assert "Enduring Angel // Angelic Enforcer" not in sent and "Enduring Angel" in sent
+    # the typo is still skipped, with how many copies
+    assert "Not recognized by Scryfall, 2 cards skipped: 2 Bera" in out
