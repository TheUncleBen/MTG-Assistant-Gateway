+def _lands_played(log: list, horizon: int) -> set[str]:
+    """Names of the lands played through turn ``horizon``, from the pinned
+    log format ``"T{n}: played X"``. A fetch land sacrificed the turn it was
+    played is never on the battlefield at a turn's end, but it was used."""
+    out: set[str] = set()
+    for line in log:
+        head, sep, rest = line.partition(": ")
+        if sep and rest.startswith("played ") and head.startswith("T"):
+            try:
+                t = int(head[1:])
+            except ValueError:
+                continue
+            if 1 <= t <= horizon:
+                out.add(rest[len("played "):])
+    return out
+
