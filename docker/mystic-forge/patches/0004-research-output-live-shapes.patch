+def test_mana_sources_that_were_played_are_not_low_impact():
+    # seed 1234 plays only Mountains in its first turns (tests/goldfish/test_golden.py)
+    rec, _log = play_one_game(mini_cards(), small_deck(), "Boss", game_seed=1234, until_turn=6)
+    assert "Mountain" in rec.mana_sources_used
+    scopes = {"Mountain": None, "Bear": None}
+    m = aggregate([rec], until_turn=6, card_scopes=scopes)
+    h = m["honesty"]
+    assert "Mountain" not in h["modeled_low_impact"]
+    assert h["modeled_mana_sources"] == ["Mountain"]
+    text = "\n".join(server._goldfish_honesty_lines(h, {}))
+    low = text.split("Modeled, low-impact", 1)[1].split("\n")[1]
+    assert "Mountain" not in low
+    assert "Modeled mana sources" in text and "not low-impact" in text
+
