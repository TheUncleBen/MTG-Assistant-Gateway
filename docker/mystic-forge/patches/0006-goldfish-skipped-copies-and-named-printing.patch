--- /dev/null
+++ b/tests/test_goldfish_skipped_copies.py
@@ -0,0 +1,28 @@
+"""The goldfish warnings for names Scryfall does not recognize say how many
+copies of each were skipped ("2 Bera"), not only the names."""
+import json
+
+import server as srv
+from tests.goldfish.helpers import _patch_fetch_minideck
+
+# The mini deck with two lines Scryfall does not know (2 + 1 copies).
+DECK = "1 Boss\n20 Plains\n17 Mountain\n28 Bear\n20 Runner\n11 Hammer\n2 Bera\n1 Hamer"
+
+
+async def test_goldfish_run_says_how_many_copies_were_skipped(monkeypatch):
+    _patch_fetch_minideck(monkeypatch)
+    out = await srv.goldfish_run(srv.GoldfishRunInput(deck=DECK, n=5, seed=1, until_turn=3))
+    assert "Warning — not recognized by Scryfall, skipped: 2 Bera, 1 Hamer" in out
+
+
+async def test_goldfish_ab_says_how_many_copies_were_skipped(monkeypatch):
+    _patch_fetch_minideck(monkeypatch)
+    out = await srv.goldfish_ab(srv.GoldfishAbInput(
+        deck_a=DECK, deck_b=DECK.replace("\n2 Bera\n1 Hamer", ""), n=5, seed=1, until_turn=3))
+    assert "Warning — deck A names not recognized by Scryfall, skipped: 2 Bera, 1 Hamer" in out
+
+
+async def test_goldfish_start_says_how_many_copies_were_skipped(monkeypatch):
+    _patch_fetch_minideck(monkeypatch)
+    res = json.loads(await srv.goldfish_start(srv.GoldfishStartInput(deck=DECK, seed=1)))
+    assert "Not recognized by Scryfall, skipped: 2 Bera, 1 Hamer" in res["warnings"]
diff --git a/tests/test_named_default_printing.py b/tests/test_named_default_printing.py
