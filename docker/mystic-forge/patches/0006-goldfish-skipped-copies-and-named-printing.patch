+++ b/tests/test_named_default_printing.py
@@ -0,0 +1,69 @@
+"""scryfall_named with no set shows the newest printing already out on paper,
+as the other lookups do, and says which printing it is."""
+import httpx
+import pytest
+
+import server
+from tests.test_default_printing import CARDS
+
+
+def _not_found(endpoint):
+    request = httpx.Request("GET", f"https://api.scryfall.com{endpoint}")
+    response = httpx.Response(404, json={"object": "error", "details": "No cards found."}, request=request)
+    return httpx.HTTPStatusError("404", request=request, response=response)
+
+
+@pytest.fixture
+def scryfall(monkeypatch):
+    calls = []
+
+    async def get(endpoint, params=None):
+        calls.append((endpoint, dict(params or {})))
+        if endpoint == "/cards/named":
+            name = params.get("exact") or params.get("fuzzy")
+            if "fuzzy" in params:
+                name = {"swmap": "Swamp"}.get(name.lower(), name)
+            # Scryfall answers with its newest printing (of the set, when one is given).
+            found = [c for c in CARDS if c["name"] == name and params.get("set") in (None, c["set"])]
+            if not found or ("exact" in params and params["exact"] != found[0]["name"]):
+                raise _not_found(endpoint)
+            return found[0]
+        assert endpoint == "/cards/search" and params["q"].startswith("oracleid:")
+        found = [c for c in CARDS if c["oracle_id"] == params["q"].split(":", 1)[1]]
+        return {"object": "list", "total_cards": len(found), "data": found}
+
+    monkeypatch.setattr(server, "_scryfall_get", get)
+    monkeypatch.setattr(server, "_today", lambda: "2026-10-11")
+    return calls
+
+
+async def test_named_skips_a_preview_and_says_which_printing(scryfall):
+    out = await server.scryfall_named(server.NamedInput(name="Swamp"))
+    assert "Set: FDN (common)" in out                  # not the MDD preview or the Arena printing
+    assert "Printing: FDN #281, the newest printing out on paper." in out
+    assert "MDD" not in out
+
+
+async def test_named_fuzzy_match_gets_the_same_printing(scryfall):
+    out = await server.scryfall_named(server.NamedInput(name="swmap"))
+    assert out.startswith("(Fuzzy match)\n")
+    assert "Printing: FDN #281, the newest printing out on paper." in out
+
+
+async def test_named_keeps_a_good_default_without_a_search(scryfall):
+    out = await server.scryfall_named(server.NamedInput(name="Sol Ring"))
+    assert "Printing: FRC #21, the newest printing out on paper." in out
+    assert [c for c in scryfall if c[0] == "/cards/search"] == []
+
+
+async def test_named_with_a_set_shows_that_printing(scryfall):
+    out = await server.scryfall_named(server.NamedInput(name="Swamp", set_code="mdd"))
+    assert "Set: MDD (common)" in out and "Printing:" not in out
+
+
+async def test_named_says_when_no_printing_is_out_on_paper(scryfall, monkeypatch):
+    monkeypatch.setattr(server, "_today", lambda: "2020-01-01")
+    out = await server.scryfall_named(server.NamedInput(name="Mountain Goat"))
+    assert "Printing: 6ED #195, the newest printing out on paper." in out
+    out = await server.scryfall_named(server.NamedInput(name="Sol Ring"))
+    assert "Printing: FRC #21, Scryfall's default printing; none is out on paper yet." in out
