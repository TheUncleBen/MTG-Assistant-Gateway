+_set_names_cache: dict[str, Any] = {"data": None, "expires_at": 0.0}
+
+
+async def _get_set_names() -> dict[str, str]:
+    """Set code -> set name, from MTGJSON's SetList (the service the deck list
+    comes from), kept a day. Empty when it can't be read: precon_search then
+    matches deck names and codes only, as before."""
+    if _set_names_cache["data"] is not None and time.time() < _set_names_cache["expires_at"]:
+        return _set_names_cache["data"]
+    try:
+        data = await _mtgjson_get("/SetList.json")
+    except Exception:
+        return {}
+    names = {str(s.get("code") or "").upper(): str(s.get("name") or "")
+             for s in data.get("data", []) if isinstance(s, dict) and s.get("code")}
+    _set_names_cache["data"] = names
+    _set_names_cache["expires_at"] = time.time() + 86400
+    return names
+
+
+def _search_words(text: str) -> list[str]:
+    """Lower-case words without punctuation: "Warhammer 40,000" -> warhammer, 40000."""
+    return re.findall(r"[a-z0-9]+", re.sub(r"(?<=\d)[,.](?=\d)", "", text.lower()))
