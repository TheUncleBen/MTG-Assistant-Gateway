diff --git a/tests/test_precon_search_set_names.py b/tests/test_precon_search_set_names.py
new file mode 100644
index 0000000..5513245
--- /dev/null
+++ b/tests/test_precon_search_set_names.py
@@ -0,0 +1,65 @@
+"""precon_search finds a precon by its set's name as well as by the deck's name
+and the set code, and says the set's name: "Reality Fracture" found nothing
+while "FRC" worked (assistant tool review, 2026-10-28). The set names come from
+MTGJSON's SetList, the same service the deck list comes from."""
+import pytest
+
+import server
+
+DECKS = [
+    {"name": "Multiverse Reforged", "code": "FRC", "type": "Commander Deck",
+     "fileName": "MultiverseReforged_FRC", "releaseDate": "2026-08-01"},
+    {"name": "Ancient Grudge", "code": "FRC", "type": "Commander Deck",
+     "fileName": "AncientGrudge_FRC", "releaseDate": "2026-08-01"},
+    {"name": "Forces of the Imperium", "code": "40K", "type": "Commander Deck",
+     "fileName": "ForcesOfTheImperium_40K", "releaseDate": "2022-10-07"},
+]
+
+
+@pytest.fixture
+def mtgjson(monkeypatch):
+    calls = []
+
+    async def get(path):
+        calls.append(path)
+        if path == "/DeckList.json":
+            return {"data": DECKS}
+        assert path == "/SetList.json"
+        return {"data": [{"code": "FRC", "name": "Reality Fracture Commander"},
+                         {"code": "40K", "name": "Warhammer 40,000 Commander"}]}
+
+    monkeypatch.setattr(server, "_mtgjson_get", get)
+    monkeypatch.setitem(server._deck_list_cache, "data", None)
+    monkeypatch.setitem(server._set_names_cache, "data", None)
+    return calls
+
+
+async def test_a_set_name_finds_its_precons_and_each_result_names_its_set(mtgjson):
+    out = await server.precon_search(server.PreconSearchInput(query="Reality Fracture"))
+    assert "(2 results)" in out
+    assert "**Multiverse Reforged** (FRC, 2026)" in out and "**Ancient Grudge** (FRC, 2026)" in out
+    assert "set: Reality Fracture Commander" in out
+    assert "Forces of the Imperium" not in out
+
+
+async def test_words_in_any_order_and_punctuation_still_match(mtgjson):
+    out = await server.precon_search(server.PreconSearchInput(query="warhammer 40000"))
+    assert "Forces of the Imperium" in out, out
+
+
+async def test_the_code_and_deck_name_still_match_and_set_names_are_read_once(mtgjson):
+    assert "Multiverse Reforged" in await server.precon_search(server.PreconSearchInput(query="frc"))
+    assert "Forces of the Imperium" in await server.precon_search(
+        server.PreconSearchInput(query="Forces of the"))
+    assert mtgjson.count("/SetList.json") == 1
+
+
+async def test_without_set_names_the_search_still_works(monkeypatch, mtgjson):
+    async def down(path):
+        if path == "/SetList.json":
+            raise RuntimeError("down")
+        return {"data": DECKS}
+
+    monkeypatch.setattr(server, "_mtgjson_get", down)
+    out = await server.precon_search(server.PreconSearchInput(query="FRC"))
+    assert "(2 results)" in out and "set:" not in out
