@@ -0,0 +1,64 @@
+"""EDHREC's average-deck and commander pages changed shape.
+
+json.edhrec.com/pages/average-decks/<slug>.json now sends "deck" as
+{"commander": [...], "cards": {type: [[name, qty], ...]}}, and the commander
+page has no num_decks_avg/avg_price (the deck count is on
+container.json_dict.card.num_decks). Shapes below are trimmed from live
+responses on 2026-10-04."""
+
+import server
+
+AVERAGE = {
+    "header": "Average Deck for Aesi, Tyrant of Gyre Strait",
+    "description": "",
+    "deck": {
+        "commander": ["Aesi, Tyrant of Gyre Strait"],
+        "commander_v2": [["Aesi, Tyrant of Gyre Strait", 1]],
+        "cards": {
+            "Artifact": [["Arcane Signet", 1], ["Sol Ring", 1]],
+            "Land": [["Command Tower", 1], ["Forest", 13], ["Island", 10]],
+            "Sorcery": [["Cultivate", 1]],
+        },
+    },
+    "container": {"json_dict": {"cardlists": []}},
+}
+
+COMMANDER = {
+    "header": "Aesi, Tyrant of Gyre Strait (Commander)",
+    "creature": 27, "instant": 11,
+    "container": {"json_dict": {
+        "card": {"name": "Aesi, Tyrant of Gyre Strait", "num_decks": 17254},
+        "cardlists": [],
+    }},
+}
+
+
+def _mock(monkeypatch, body):
+    async def fake_get(path):
+        return body
+    monkeypatch.setattr(server, "_edhrec_get", fake_get)
+
+
+async def test_average_deck_new_shape(monkeypatch):
+    _mock(monkeypatch, AVERAGE)
+    out = await server.edhrec_average_deck(server.CommanderInput(name="Aesi, Tyrant of Gyre Strait"))
+    assert "## Commander\n1 Aesi, Tyrant of Gyre Strait" in out
+    assert "## Land" in out and "13 Forest" in out and "10 Island" in out
+    assert "1 Sol Ring" in out and "1 Cultivate" in out
+    assert "Total: 28 cards" in out
+    assert "commander_v2" not in out and "$?" not in out
+
+
+async def test_average_deck_old_list_shape_still_works(monkeypatch):
+    _mock(monkeypatch, {"header": "Average Deck", "avg_price": 250,
+                        "deck": ["1 Sol Ring", "1 Arcane Signet"]})
+    out = await server.edhrec_average_deck(server.CommanderInput(name="x"))
+    assert "Avg price: $250" in out
+    assert "1 Sol Ring" in out and "Total: 2 cards" in out
+
+
+async def test_commander_deck_count_from_card(monkeypatch):
+    _mock(monkeypatch, COMMANDER)
+    out = await server.edhrec_commander(server.CommanderInput(name="Aesi, Tyrant of Gyre Strait"))
+    assert "Based on 17254 decks" in out
+    assert "Avg price" not in out
