+"""scryfall_search shows `limit` cards a page (default 20) and says how to get
+the next, and shows each card in the printing scryfall_named would: the newest
+printing out on paper, unless another policy is asked for."""
+import pytest
+
+import server
+
+
+def _card(i: int) -> dict:
+    return {"object": "card", "name": f"Card {i:03d}", "set": "abc", "collector_number": str(i),
+            "type_line": "Creature", "mana_cost": "{1}", "oracle_text": "", "rarity": "common"}
+
+
+ALL = [_card(i) for i in range(1, 231)]   # 230 cards: two Scryfall pages of 175
+
+
+@pytest.fixture
+def scryfall(monkeypatch):
+    calls = []
+
+    async def get(endpoint, params=None):
+        calls.append((endpoint, dict(params or {})))
+        assert endpoint == "/cards/search"
+        page = int(params.get("page", 1))
+        chunk = ALL[(page - 1) * 175: page * 175]
+        return {"object": "list", "total_cards": len(ALL), "has_more": page * 175 < len(ALL),
+                "data": chunk}
+
+    monkeypatch.setattr(server, "_scryfall_get", get)
+    return calls
+
+
+async def test_search_shows_twenty_by_default_and_says_how_to_get_more(scryfall):
+    out = await server.scryfall_search(server.SearchInput(query="t:creature"))
+    assert out.startswith("Found 230 card(s). Showing 1-20.")
+    assert "Card 020" in out and "Card 021" not in out
+    assert "page=2 for the next 20" in out
+
+
+async def test_a_later_page_of_the_limit_reads_across_scryfalls_pages(scryfall):
+    out = await server.scryfall_search(server.SearchInput(query="t:creature", limit=50, page=4))
+    assert out.startswith("Found 230 card(s). Showing 151-200.")
+    assert "Card 151" in out and "Card 200" in out and "Card 201" not in out
+    assert [c[1]["page"] for c in scryfall] == [1, 2]
+    last = await server.scryfall_search(server.SearchInput(query="t:creature", limit=50, page=5))
+    assert last.startswith("Found 230 card(s). Showing 201-230.") and "page=6" not in last
+
+
+async def test_a_page_past_the_end_says_so(scryfall):
+    out = await server.scryfall_search(server.SearchInput(query="t:creature", page=20))
+    assert out.startswith("Found 230 card(s). Page 20 is past the last (12 pages of 20).")
+
+
+async def test_search_shows_the_newest_paper_printing_as_scryfall_named_does(scryfall):
+    await server.scryfall_search(server.SearchInput(query="t:goblin id<=r"))
+    assert scryfall[0][1]["q"] == "(t:goblin id<=r) game:paper prefer:newest"
+    out = await server.scryfall_search(server.SearchInput(query="t:goblin"))
+    assert "Printings: the newest out on paper, as scryfall_named shows" in out
+
+
+async def test_another_printing_policy_or_the_querys_own_prefer_is_kept(scryfall):
+    await server.scryfall_search(server.SearchInput(query="t:goblin", printing="scryfall"))
+    await server.scryfall_search(server.SearchInput(query="t:goblin", printing="cheapest"))
+    await server.scryfall_search(server.SearchInput(query="t:goblin", printing="oldest"))
+    await server.scryfall_search(server.SearchInput(query="t:goblin prefer:promo"))
+    await server.scryfall_search(server.SearchInput(query="t:goblin game:arena"))
+    assert [c[1]["q"] for c in scryfall] == [
+        "t:goblin",
+        "(t:goblin) prefer:usd-low",
+        "(t:goblin) prefer:oldest",
+        "t:goblin prefer:promo",
+        "(t:goblin game:arena) prefer:newest",
+    ]
