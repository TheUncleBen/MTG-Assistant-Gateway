+def _search_query(query: str, printing: SearchPrinting) -> str:
+    """The query with the printing policy added as Scryfall's prefer: (and, for the newest
+    printing out on paper, game:paper unless the query names a game). The query is put in
+    parentheses so an "or" in it does not split the added terms off."""
+    if printing == SearchPrinting.SCRYFALL or _PREFER_TERM.search(query):
+        return query
+    extra = {SearchPrinting.CHEAPEST: "prefer:usd-low", SearchPrinting.OLDEST: "prefer:oldest"}.get(
+        printing, "prefer:newest" if _GAME_TERM.search(query) else "game:paper prefer:newest")
+    return f"({query}) {extra}"
+
