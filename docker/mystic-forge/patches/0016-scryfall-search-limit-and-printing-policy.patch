+_SCRYFALL_PAGE = 175          # cards per page of Scryfall's /cards/search
+_PREFER_TERM = re.compile(r"(?<![\w])-?prefer:", re.IGNORECASE)
+_GAME_TERM = re.compile(r"(?<![\w])-?game[:=]", re.IGNORECASE)
+_PRINTING_WORDS = {
+    SearchPrinting.NEWEST_PAPER: "the newest out on paper, as scryfall_named shows",
+    SearchPrinting.SCRYFALL: "Scryfall's own choice",
+    SearchPrinting.CHEAPEST: "the cheapest in USD",
+    SearchPrinting.OLDEST: "the oldest",
+}
