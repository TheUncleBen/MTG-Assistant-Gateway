@@ -0,0 +1,86 @@
+"""Two fixes from the ChatGPT connector test of 2026-10-25.
+
+1. Right after a restart the rules tools answered from the bundled
+   Comprehensive Rules copy (effective August 7, 2026) until the first call
+   started the download of the current one, so one answer could say August 7
+   and the next September 25. The download now starts when the server starts.
+2. A card with two faces in a search result was printed as its first face,
+   a bare "---" and its second face, the same marker the numbered list uses
+   between results ("--- 34 ---"), so a reader took the second face for a
+   card the search had returned. The second face is now labelled.
+"""
+import asyncio
+
+import server
+from tests.test_http_surface import run_lifespan
+
+
+def test_startup_starts_the_rules_download(monkeypatch):
+    monkeypatch.setenv("MYSTIC_FORGE_NO_INGEST", "1")   # as the gateway's stack runs it
+    monkeypatch.delenv("MYSTIC_FORGE_NO_CR_WARMUP", raising=False)
+    calls = []
+
+    async def fake_index():
+        calls.append("rules")
+
+    monkeypatch.setattr(server, "_get_rules_index", fake_index)
+    run_lifespan("lifespan.startup.complete")
+    assert calls == ["rules"]
+
+
+def test_a_second_startup_event_does_not_start_it_twice(monkeypatch):
+    monkeypatch.delenv("MYSTIC_FORGE_NO_CR_WARMUP", raising=False)
+    calls = []
+
+    async def fake_index():
+        calls.append("rules")
+
+    monkeypatch.setattr(server, "_get_rules_index", fake_index)
+    run_lifespan("lifespan.startup.complete", "lifespan.startup.complete")
+    assert calls == ["rules"]
+
+
+def test_the_warmup_can_be_switched_off(monkeypatch):
+    monkeypatch.setenv("MYSTIC_FORGE_NO_CR_WARMUP", "1")
+    calls = []
+
+    async def fake_index():
+        calls.append("rules")
+
+    monkeypatch.setattr(server, "_get_rules_index", fake_index)
+    run_lifespan("lifespan.startup.complete")
+    assert calls == []
+
+
+_PREPARE = {
+    "name": "Emeritus of Truce // Swords to Plowshares",
+    "layout": "prepare",
+    "color_identity": ["W"],
+    "card_faces": [
+        {"name": "Emeritus of Truce", "mana_cost": "{1}{W}{W}",
+         "type_line": "Creature — Cat Cleric", "oracle_text": "When this creature enters, ...",
+         "power": "3", "toughness": "3"},
+        {"name": "Swords to Plowshares", "mana_cost": "{W}", "type_line": "Instant",
+         "oracle_text": "Exile target creature. Its controller gains life equal to its power."},
+    ],
+}
+
+
+def test_a_second_face_is_labelled_as_part_of_the_same_card():
+    text = server._format_card(_PREPARE)
+    lines = text.splitlines()
+    assert "---" not in lines
+    assert "Other face of Emeritus of Truce // Swords to Plowshares:" in lines
+    assert lines.index("Other face of Emeritus of Truce // Swords to Plowshares:") < next(
+        i for i, l in enumerate(lines) if "Swords to Plowshares**" in l)
+
+
+def test_a_search_list_numbers_only_cards():
+    text = server._format_card_list([_PREPARE], total=1, has_more=False)
+    assert [l for l in text.splitlines() if l.startswith("---")] == ["--- 1 ---"]
+
+
+def test_a_one_face_card_is_unchanged():
+    card = {"name": "Sol Ring", "mana_cost": "{1}", "type_line": "Artifact",
+            "oracle_text": "{T}: Add {C}{C}.", "color_identity": []}
+    assert "Other face" not in server._format_card(card)
