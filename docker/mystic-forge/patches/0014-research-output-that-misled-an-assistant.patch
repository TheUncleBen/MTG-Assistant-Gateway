+"""Research output that misled an assistant (review of 2026-10-28)."""
+import server
+
+
+async def test_commander_breakdown_spells_plurals(monkeypatch):
+    async def fake_get(path):
+        return {"header": "Krenko", "creature": 30, "sorcery": 8, "instant": 1}
+    monkeypatch.setattr(server, "_edhrec_get", fake_get)
+    out = await server.edhrec_commander(server.CommanderInput(name="Krenko, Mob Boss"))
+    assert "30 creatures, 1 instant, 8 sorceries" in out
+    assert "sorcerys" not in out
+
+
+async def test_recommendations_same_scores_basics_and_small_input(monkeypatch):
+    async def fake_post(path, body):
+        return {"inRecs": [{"name": "Goblin Matron", "score": 100},
+                           {"name": "Mountain", "score": 100},
+                           {"name": "Skirk Prospector", "score": 100}],
+                "outRecs": [{"name": "Sol Ring"}, {"name": "Goblin Warchief"}]}
+    monkeypatch.setattr(server, "_edhrec_post", fake_post)
+    out = await server.edhrec_recommendations(server.RecsInput(
+        commanders=["Krenko, Mob Boss"], cards=["Sol Ring", "Goblin Warchief"]))
+    assert "Mountain" not in out.split("## Suggested Additions", 1)[1].split("(", 1)[0]
+    assert "1 basic land(s) EDHREC suggested are left out" in out
+    assert "same score (100)" in out and "(score: 100)" not in out
+    assert "Consider Cutting" not in out
+    assert "No cuts are listed: with 2 card(s) given" in out
+
+
+async def test_combos_most_played_first(monkeypatch):
+    async def fake_get(path):
+        return {"container": {"json_dict": {"cardlists": [
+            {"tag": "a (17485decks)", "cardviews": [{"name": "A"}]},
+            {"tag": "b (20960decks)", "cardviews": [{"name": "B"}]},
+            {"tag": "c", "cardviews": [{"name": "C"}]},
+        ]}}}
+    monkeypatch.setattr(server, "_edhrec_get", fake_get)
+    out = await server.edhrec_combos(server.CommanderInput(name="Krenko, Mob Boss"))
+    assert out.index("20960 decks") < out.index("17485 decks") < out.index("(? decks)")
+    assert "**Combo 1** (20960 decks)" in out
+
+
+async def test_top_cards_lands_by_count_and_period_note(monkeypatch):
+    async def fake_get(path):
+        return {"header": "Lands", "container": {"json_dict": {"cardlists": [
+            {"header": "Basic", "cardviews": [
+                {"name": "Forest", "num_decks": 4460000},
+                {"name": "Mountain", "num_decks": 4780000},
+                {"name": "Plains", "num_decks": 4480000}]}]}}}
+    monkeypatch.setattr(server, "_edhrec_get", fake_get)
+    out = await server.edhrec_top_cards(server.TopCardsInput(color="lands", limit=3))
+    assert out.index("Mountain") < out.index("Plains") < out.index("Forest")
+    assert "Period ignored" not in out
+    assert "no time period" in out
+    out = await server.edhrec_top_cards(server.TopCardsInput(color="lands", period="month"))
+    assert "Period ignored" in out
+
+
+async def test_spellbook_steps_numbered_and_fields_always_shown(monkeypatch):
+    variant = {"uses": [{"card": {"name": "Krenko, Mob Boss"}}],
+               "description": "Tap Krenko.\nSacrifice goblins.\nRepeat step 1.",
+               "manaNeeded": "", "easyPrerequisites": "", "produces": []}
+
+    async def fake_get(path, params=None):
