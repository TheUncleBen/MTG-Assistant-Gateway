+    assert "Steps:\n1. Tap Krenko.\n2. Sacrifice goblins.\n3. Repeat step 1." in out
+    assert "Mana needed: none" in out and "Prerequisites: none" in out
+
+
+async def test_precon_search_one_result_and_year(monkeypatch):
+    async def fake_list():
+        return [{"name": "Multiverse Reforged", "code": "FRC", "type": "Commander Deck",
+                 "fileName": "MultiverseReforged_FRC", "releaseDate": "2026-08-01"}]
+    monkeypatch.setattr(server, "_get_deck_list", fake_list)
