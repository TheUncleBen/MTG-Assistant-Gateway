+@pytest.mark.parametrize("card,triggers,note", MORE_READ, ids=[c[0]["name"] for c in MORE_READ])
+def test_more_wording_is_read(card, triggers, note):
+    d = _derived(card)
+    assert d.auto_annotated and not d.needs_annotation, d.unread
+    assert d.card.scope_class is None and d.aside_class is None
+    assert _ann(d) == (triggers, [])
+    assert any(n.startswith(note) for n in d.approx_notes), d.approx_notes
+
