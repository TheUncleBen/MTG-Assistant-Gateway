+@pytest.mark.parametrize("card,scope,aside", NEEDS_OPPONENTS,
+                         ids=[c[0]["name"] for c in NEEDS_OPPONENTS])
+def test_cards_that_need_opponents_are_set_aside(card, scope, aside):
+    d = _derived(card)
+    assert not d.needs_annotation, d.unread
+    assert d.card.scope_class == scope
+    assert d.aside_class == aside
