diff --git a/tests/goldfish/test_constructed.py b/tests/goldfish/test_constructed.py
new file mode 100644
--- /dev/null
+++ b/tests/goldfish/test_constructed.py
@@ -0,0 +1,117 @@
+"""Constructed (60-card) goldfish games: no commander, 20 life, no free
+mulligan, on the play (patch 0007)."""
+import json
+
+import server as srv
+from mystic_forge.goldfish.engine import MulliganRules, auto_mulligan, new_game
+from mystic_forge.goldfish.runner import run_batch
+from tests.goldfish.helpers import MINI_DECK_TEXT, _patch_fetch_minideck, mini_cards
+
+# 60 cards, no commander line: the first line is an ordinary card.
+SIXTY = "4 Runner\n20 Mountain\n4 Plains\n24 Bear\n8 Hammer"
+
+
+def _deck60():
+    return ["Runner"] * 4 + ["Mountain"] * 20 + ["Plains"] * 4 + ["Bear"] * 24 + ["Hammer"] * 8
+
+
+def _json_payload(out: str) -> dict:
+    return json.loads(out.split("```json")[1].split("```")[0])
+
+
+def test_new_game_constructed_has_no_commander_and_20_life():
+    g = new_game(mini_cards(), _deck60(), None, seed=3, opponents=2, constructed=True)
+    assert g.command == []
+    assert g.commander_name is None
+    assert g.opponents == [20, 20]
+    assert len(g.hand) == 7 and len(g.library) == 53
+    # The commander default is unchanged.
+    c = new_game(mini_cards(), _deck60(), "Boss", seed=3)
+    assert c.command == ["Boss"] and c.opponents == [40]
+
+
+def test_constructed_is_on_the_play():
+    g = new_game(mini_cards(), _deck60(), None, seed=5, constructed=True)
+    auto_mulligan(g, MulliganRules(free_first=False))
+    assert g.turn == 1
+    assert len(g.hand) == g.kept_hand_size          # no draw on turn 1
+    c = new_game(mini_cards(), _deck60(), "Boss", seed=5)
+    auto_mulligan(c, MulliganRules())
+    assert len(c.hand) == c.kept_hand_size + 1      # commander games always draw
+
+
+def test_run_batch_constructed_never_casts_a_commander():
+    out = run_batch(mini_cards(), _deck60(), None, n=30, seed=1, until_turn=6,
+                    rules=MulliganRules(free_first=False), constructed=True)
+    assert all(r.commander_cast_turn is None for r in out["records"])
+    assert out["metrics"]["commander_cast"]["reached_pct"]["value"] == 0
+
+
+async def test_load_deck_constructed_keeps_every_card():
+    names, commander, note = await srv._goldfish_load_deck(SIXTY, constructed=True)
+    assert commander is None and note is None
+    assert len(names) == 60 and names.count("Runner") == 4
+    # Without the flag the first line is still the commander.
+    names, commander, _ = await srv._goldfish_load_deck(SIXTY)
+    assert commander == "Runner"
+
+
+async def test_goldfish_run_constructed(monkeypatch):
+    _patch_fetch_minideck(monkeypatch)
+    out = await srv.goldfish_run(srv.GoldfishRunInput(
+        deck=SIXTY, n=20, seed=4, until_turn=6, constructed=True))
+    assert "Deck: 60 cards | Format: 60-card (no commander, 20 life, on the play)" in out
+    assert "Commander" not in out.split("## Metrics")[0]
+    assert "Kill (20 damage)" in out
+    payload = _json_payload(out)
+    assert payload["metrics"]["commander_cast"]["reached_pct"]["value"] == 0
+    stored = srv._GOLDFISH_RUNS[payload["run_id"]]
+    assert stored["inputs"]["constructed"] is True
+    assert stored["inputs"]["commander"] is None
+    assert len(stored["inputs"]["library"]) == 60
+    html = srv._goldfish_entry_html(stored)
+    assert "Kill (20 damage)" in html and "Commander cast" not in html
+
+
+async def test_goldfish_run_constructed_has_no_free_mulligan(monkeypatch):
+    _patch_fetch_minideck(monkeypatch)
+    seen = {}
+    real = srv.run_batch
+
+    def spy(*args, **kw):
+        seen.update(kw)
+        return real(*args, **kw)
+
+    monkeypatch.setattr(srv, "run_batch", spy)
+    await srv.goldfish_run(srv.GoldfishRunInput(deck=SIXTY, n=5, constructed=True))
+    assert seen["rules"].free_first is False and seen["constructed"] is True
+    await srv.goldfish_run(srv.GoldfishRunInput.model_validate(
+        {"deck": SIXTY, "n": 5, "constructed": True, "mulligan": {"free_first": True}}))
+    assert seen["rules"].free_first is True             # an explicit override wins
+
+
+async def test_commander_run_id_unchanged_by_the_new_field(monkeypatch):
+    _patch_fetch_minideck(monkeypatch)
+    out = await srv.goldfish_run(srv.GoldfishRunInput(deck=MINI_DECK_TEXT, n=5, seed=9))
+    stored = srv._GOLDFISH_RUNS[_json_payload(out)["run_id"]]
+    assert "constructed" not in stored["inputs"]
+    assert "Commander: Boss" in out and "Kill (40 damage)" in out
+
+
+async def test_goldfish_ab_constructed(monkeypatch):
+    _patch_fetch_minideck(monkeypatch)
+    out = await srv.goldfish_ab(srv.GoldfishAbInput(
+        deck_a=SIXTY, deck_b=SIXTY, n=10, seed=2, constructed=True))
+    assert "Format: 60-card" in out
+    payload = _json_payload(out)
+    assert all(d["mean"] == 0.0 for d in payload["deltas"].values())
+
+
+async def test_annotate_constructed_header(monkeypatch):
+    _patch_fetch_minideck(monkeypatch)
+    out = await srv.goldfish_annotate(srv.GoldfishAnnotateInput(deck=SIXTY, constructed=True))
+    assert "Deck: 60 cards | No commander (60-card game)" in out
+    assert "EDH decks are 100" not in out
+    short = await srv.goldfish_annotate(srv.GoldfishAnnotateInput(
+        deck="20 Mountain\n20 Bear", constructed=True))
+    assert "at least 60" in short
