+++ b/tests/test_research_wording_2.py
@@ -0,0 +1,23 @@
+"""Wording an assistant read wrongly (assistant tool review, 2026-10-28): a rules search's count
+of entries that have any one of the terms, and the annotate heading that said permanents are not
+cast."""
+import server
+
+from tests.test_rules_tools import _install_index
+
+
+async def test_a_search_of_several_terms_counts_entries_with_any_of_them(monkeypatch):
+    _install_index(monkeypatch)
+    out = await server.rules_search(server.RulesSearchInput(query="deathtouch damage"))
+    assert "mention at least one of these terms" in out
+    assert "mention these terms" not in out
+
+
+async def test_the_out_of_scope_heading_says_permanents_are_cast(monkeypatch):
+    from tests.goldfish import test_server_tools as t
+
+    monkeypatch.setattr(server, "_goldfish_fetch_cards", t._fake_fetch_for([t.PLAINS, t.SWORDS]))
+    out = await server.goldfish_annotate(server.GoldfishAnnotateInput(deck="1 Plains\n1 Swords to Plowshares"))
+    section = out.split("## Out of scope", 1)[1].split("## Needs annotation", 1)[0]
+    assert "Not cast in the sim" not in section
+    assert "permanents are cast for the rest of their text" in section
