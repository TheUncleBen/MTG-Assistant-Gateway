+from datetime import datetime, timezone
+
+
+def _today() -> str:
+    """Today in UTC, as Scryfall writes released_at (YYYY-MM-DD). Tests replace it."""
+    return datetime.now(timezone.utc).date().isoformat()
+
+
+def _good_default(card: dict, finish: Optional[str] = None) -> bool:
+    """A printing that may stand in when no set was named: released by today,
+    sold on paper (a preview has games: [] until it is out), and in `finish`
+    when one was asked for."""
+    released = card.get("released_at") or ""
+    games = card.get("games")
+    return ((not released or released <= _today())
+            and (not isinstance(games, list) or "paper" in games)
+            and (not finish or not card.get("finishes") or finish in card["finishes"]))
+
+
+async def _default_printing(card: dict, finish: Optional[str] = None) -> tuple[dict, list[str]]:
+    """The printing to use for a line that named no set, and every finish the
+    card comes in.
+
+    Scryfall's default printing is its newest, which can be a preview that is
+    not out yet (no paper, no prices) or a digital-only printing. This returns
+    the newest released paper printing, in `finish` when one was asked for and
+    some printing has it; else the newest released paper printing; else the
+    card as Scryfall gave it. Costs one search, and only when the default
+    printing is no good.
+    """
+    finishes = sorted(card.get("finishes") or [])
+    if _good_default(card, finish):
+        return card, finishes
+    faces = card.get("card_faces") or [{}]
+    oracle_id = card.get("oracle_id") or faces[0].get("oracle_id")
+    if not oracle_id:
+        return card, finishes
+    try:
+        data = await _scryfall_get("/cards/search", params={
+            "q": f"oracleid:{oracle_id}", "unique": "prints",
+            "order": "released", "dir": "desc"})
+    except Exception:
+        return card, finishes      # keep Scryfall's choice rather than fail the line
+    prints = [c for c in data.get("data", []) if isinstance(c, dict)]
+    finishes = sorted({f for c in prints for f in c.get("finishes") or []} | set(finishes))
+    for want in ([finish, None] if finish else [None]):
+        pick = next((c for c in prints if _good_default(c, want)), None)
+        if pick is not None:
+            return pick, finishes
+    return card, finishes
+
