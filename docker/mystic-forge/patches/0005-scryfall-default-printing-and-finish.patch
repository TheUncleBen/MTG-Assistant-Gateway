+++ b/tests/test_default_printing.py
@@ -0,0 +1,145 @@
+"""Lines that name no set use the newest printing already out on paper, in the
+finish asked for; a finish no printing has is said plainly, never marked."""
+import re
+
+import httpx
+import pytest
+
+import server
+
+SOL = "6ad8011d-3471-4369-9d68-b264cc027487"
+SWAMP = "56719f6a-1a6c-4c0a-8d21-18f7d7350b68"
+GOAT = "031cd561-d9b1-4a0e-bc38-bc09e80563c3"
+
+
+def _card(name, oracle, set_code, number, released, games, finishes, usd=None, usd_foil=None):
+    return {"object": "card", "name": name, "oracle_id": oracle, "set": set_code,
+            "set_name": set_code.upper(), "collector_number": number, "rarity": "common",
+            "released_at": released, "games": games, "finishes": finishes,
+            "prices": {"usd": usd, "usd_foil": usd_foil}}
+
+
+# Newest first, as Scryfall lists printings; the first of each name is its default.
+CARDS = [
+    _card("Swamp", SWAMP, "mdd", "296", "2027-04-09", [], ["nonfoil", "foil"]),
+    _card("Swamp", SWAMP, "ea1", "71", "2026-08-12", ["arena"], ["nonfoil"]),
+    _card("Swamp", SWAMP, "fdn", "281", "2024-11-15", ["paper", "arena"], ["nonfoil", "foil"], "0.10"),
+    _card("Sol Ring", SOL, "frc", "21", "2026-10-02", ["paper"], ["nonfoil"], "1.48"),
+    _card("Sol Ring", SOL, "ltc", "284", "2023-06-23", ["paper"], ["nonfoil"], "3.51"),
+    _card("Sol Ring", SOL, "c21", "263", "2021-04-23", ["paper"], ["nonfoil", "foil"], "2.00", "9.00"),
+    _card("Mountain Goat", GOAT, "6ed", "195", "1999-04-21", ["paper"], ["nonfoil"], "0.25"),
+]
+
+
+def _not_found():
+    request = httpx.Request("GET", "https://api.scryfall.com/cards/search")
+    response = httpx.Response(404, json={"object": "error", "details": "Your query didn't match any cards."},
+                              request=request)
+    return httpx.HTTPStatusError("404", request=request, response=response)
+
+
+@pytest.fixture
+def scryfall(monkeypatch):
+    calls = []
+
+    async def post(endpoint, body):
+        assert endpoint == "/cards/collection"
+        data, missing = [], []
+        for ident in body["identifiers"]:
+            if "collector_number" in ident:
+                hit = [c for c in CARDS if (c["set"], c["collector_number"])
+                       == (ident["set"], ident["collector_number"])]
+            else:
+                hit = [c for c in CARDS if c["name"].lower() == ident["name"].lower()
+                       and ident.get("set") in (None, c["set"])]
+            (data.append(hit[0]) if hit else missing.append(ident))
+        calls.append(("post", [dict(i) for i in body["identifiers"]]))
+        return {"object": "list", "data": data, "not_found": missing}
+
+    async def get(endpoint, params=None):
+        assert endpoint == "/cards/search"
+        q = params["q"]
+        calls.append(("get", q))
+        if q.startswith("oracleid:"):
+            found = [c for c in CARDS if c["oracle_id"] == q.split(":", 1)[1]]
+        else:
+            name = re.search(r'!"([^"]+)"', q).group(1)
+            found = [c for c in CARDS if c["name"] == name]
+            for key, field in (("set", "set"), ("cn", "collector_number")):
+                m = re.search(rf"\b{key}:(\S+)", q)
+                if m:
+                    found = [c for c in found if c[field] == m.group(1)]
+            m = re.search(r"\bis:(foil|etched|nonfoil)\b", q)
+            if m:
+                found = [c for c in found if m.group(1) in c["finishes"]]
+        if not found:
+            raise _not_found()
+        return {"object": "list", "total_cards": len(found), "data": found}
+
+    monkeypatch.setattr(server, "_scryfall_post", post)
+    monkeypatch.setattr(server, "_scryfall_get", get)
+    monkeypatch.setattr(server, "_today", lambda: "2026-10-11")
+    return calls
+
+
+async def test_format_archidekt_names_a_released_paper_printing_in_the_finish(scryfall):
+    out = await server.format_archidekt(server.FormatDeckInput(include_set_codes=True, cards=[
+        server.DeckCardEntry(name="Swamp", quantity=30),
+        server.DeckCardEntry(name="Sol Ring", category="Ramp", finish="foil"),
+        server.DeckCardEntry(name="Mountain Goat", finish="foil"),
+        server.DeckCardEntry(name="Sol Ring", category="Spare"),
+    ]))
+    lines = out.splitlines()
+    assert "30x Swamp (fdn) 281" in lines                 # not the MDD preview
+    assert "1x Sol Ring (c21) 263 *F* [Ramp]" in lines    # FRC #21 has no foil
+    assert "1x Sol Ring (frc) 21 [Spare]" in lines        # newest, released, no finish asked
+    assert "1x Mountain Goat (6ed) 195" in lines          # never *F* on a nonfoil-only card
+    assert ("# WARNING: no printing of 'Mountain Goat' comes in foil (it comes: nonfoil); "
+            "listed without the *F* marker") in lines
+
+
+async def test_format_archidekt_checks_the_finish_without_set_codes(scryfall):
+    out = await server.format_archidekt(server.FormatDeckInput(cards=[
+        server.DeckCardEntry(name="Mountain Goat", finish="foil"),
+        server.DeckCardEntry(name="Sol Ring", finish="foil"),
+    ]))
+    lines = out.splitlines()
+    assert "1x Mountain Goat" in lines and "1x Sol Ring *F*" in lines
+    assert any("no printing of 'Mountain Goat' comes in foil" in line for line in lines)
+
+
+async def test_format_archidekt_skips_the_search_when_the_default_is_good(scryfall):
+    await server.format_archidekt(server.FormatDeckInput(include_set_codes=True, cards=[
+        server.DeckCardEntry(name="Sol Ring")]))
+    assert [c for c in scryfall if c[0] == "get"] == []
+
+
+async def test_price_list_defaults_to_a_released_paper_printing(scryfall):
+    out = await server.scryfall_price_list(server.PriceListInput(
+        decklist="2x Sol Ring (ltc) 284\n1 Sol Ring\n1 Swamp\n1 Sol Ring *F*"))
+    assert "- 2x Sol Ring (LTC #284, nonfoil) — $3.51 ea → $7.02" in out
+    # The pinned LTC line does not stand in for the unpinned one.
+    assert "- 1x Sol Ring (FRC #21, nonfoil) — $1.48 ea → $1.48" in out
+    assert "- 1x Swamp (FDN #281, nonfoil) — $0.10 ea → $0.10" in out
+    assert "- 1x Sol Ring (C21 #263, foil) — $9.00 ea → $9.00" in out
+    assert "MDD" not in out and "newest printing out on paper used" in out
+    posts = [c[1] for c in scryfall if c[0] == "post"]
+    assert posts[0] == [{"set": "ltc", "collector_number": "284"}]  # pinned lines asked apart
+
+
+async def test_price_says_a_pinned_printing_exists_but_not_in_that_finish(scryfall):
+    out = await server.scryfall_price(server.PriceInput(
+        name="Sol Ring", set_code="ltc", collector_number="284", finish="foil"))
+    assert out.startswith("Sol Ring LTC #284 exists, but not in foil: it only comes nonfoil.")
+    assert "Available finishes: nonfoil $3.51" in out
+
+
+async def test_price_says_no_printing_comes_in_that_finish(scryfall):
+    out = await server.scryfall_price(server.PriceInput(name="Mountain Goat", finish="foil"))
+    assert out == "No printing of Mountain Goat comes in foil. They come: nonfoil."
+
+
+async def test_price_still_says_no_results_for_a_printing_that_does_not_exist(scryfall):
+    out = await server.scryfall_price(server.PriceInput(
+        name="Sol Ring", set_code="ltc", collector_number="999", finish="foil"))
+    assert out.startswith("No results found.")
