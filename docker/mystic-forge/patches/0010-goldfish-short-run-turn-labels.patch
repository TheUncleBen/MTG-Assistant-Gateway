diff --git a/tests/goldfish/test_short_run_labels.py b/tests/goldfish/test_short_run_labels.py
new file mode 100644
index 0000000..8c4504a
--- /dev/null
+++ b/tests/goldfish/test_short_run_labels.py
@@ -0,0 +1,60 @@
+"""A run shorter than the summary's fixed turns names the turns it played.
+
+The on-curve metric is judged through min(5, until_turn) and the 4+-spell
+turn through min(6, until_turn) (metrics.py), and a commander cast "by T4"
+in a 3-turn run is only a cast by T3. The text and the report tiles said
+T4, T5 and T6 whatever the run's length.
+"""
+from mystic_forge.goldfish import report
+import server as srv
+
+
+def _p(v=0.5):
+    return {"value": v, "ci": [0.4, 0.6]}
+
+
+def _metrics():
+    return {
+        "commander_cast": {"reached_pct": _p(), "median_among_reached": 3,
+                           "pct_by_turn": {"4": _p(), "5": _p(), "6": _p()}},
+        "kill": {"reached_pct": _p(0.0), "median_among_reached": None},
+        "damage": {"avg_total": 4.0, "combat": {"avg_total": 4.0},
+                   "noncombat": {"avg_total": 0.0}},
+        "mulligans": {"pct_mulliganed": _p(), "avg_kept_hand_size": 6.9,
+                      "avg_kept_lands": 3.0},
+        "on_curve": {"pct_all_drops_through_t5": _p(0.9)},
+        "casts": {"pct_4plus_turn_by_t6": _p(0.0)},
+        "trigger_fires": {},
+    }
+
+
+def test_short_run_summary_names_the_turns_played():
+    text = "\n".join(srv._goldfish_summary_lines(_metrics(), 3))
+    assert "through T3" in text
+    assert "T5" not in text and "T4" not in text and "T6" not in text
+
+
+def test_long_run_summary_is_unchanged():
+    text = "\n".join(srv._goldfish_summary_lines(_metrics(), 10))
+    assert "by T4 50.0% [40.0–60.0], T5 50.0% [40.0–60.0], T6 50.0% [40.0–60.0]" in text
+    assert "made every land drop through T5" in text
+
+
+def test_short_run_constructed_summary():
+    text = "\n".join(srv._goldfish_summary_lines(_metrics(), 4, constructed=True))
+    assert "made every land drop through T4" in text
+
+
+def test_short_run_tiles_name_the_turns_played():
+    html = report._stat_tiles(_metrics(), 3)
+    assert "On-curve through T3" in html
+    assert "4+-spell turn by T3" in html
+    assert "Commander cast by T4" not in html
+    assert "T5" not in html and "T6" not in html
+
+
+def test_long_run_tiles_are_unchanged():
+    html = report._stat_tiles(_metrics(), 10)
+    assert "On-curve through T5" in html
+    assert "4+-spell turn by T6" in html
+    assert "Commander cast by T4" in html
