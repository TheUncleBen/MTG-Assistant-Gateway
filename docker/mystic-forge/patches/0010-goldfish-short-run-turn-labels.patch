+    if not constructed and until_turn >= 4:
+        tiles.append(_tile("Commander cast by T4",
+                           m["commander_cast"]["pct_by_turn"]["4"]))
     tiles += [
         _tile(f"Kill ({20 if constructed else 40} damage) by T{until_turn}",
               m["kill"]["reached_pct"]),
         _tile("Games mulliganed", m["mulligans"]["pct_mulliganed"]),
-        _tile("On-curve through T5", m["on_curve"]["pct_all_drops_through_t5"]),
-        _tile("4+-spell turn by T6", m["casts"]["pct_4plus_turn_by_t6"]),
+        _tile(f"On-curve through T{min(5, until_turn)}",
+              m["on_curve"]["pct_all_drops_through_t5"]),
+        _tile(f"4+-spell turn by T{min(6, until_turn)}",
+              m["casts"]["pct_4plus_turn_by_t6"]),
     ]
     return '<div class="tiles">' + "".join(tiles) + "</div>"
 
