+@pytest.mark.parametrize("card,triggers,statics", MODELED, ids=[c[0]["name"] for c in MODELED])
+def test_known_card_readings(card, triggers, statics):
+    d = _derived(card)
+    if triggers is None:
+        assert d.needs_annotation and d.unread
+        return
+    assert d.auto_annotated and not d.needs_annotation, d.unread
+    assert d.card.scope_class is None and d.aside_class is None
+    assert _ann(d) == (triggers, statics)
