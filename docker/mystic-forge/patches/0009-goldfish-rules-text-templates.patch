+def _card(name, type_line, cost, text, power=None, toughness=None, keywords=()):
+    return {"name": name, "type_line": type_line, "mana_cost": cost, "oracle_text": text,
+            "power": power, "toughness": toughness, "keywords": list(keywords)}
+
+
+def _ann(d):
+    a = d.card.ann
+    trig = sorted((t.on, t.do, t.count if isinstance(t.count, int) else str(t.count),
+                   t.target, t.event_filter, t.power, t.toughness, t.duration)
+                  for t in a.triggers) if a else []
+    stat = sorted((s.kind, s.power, s.toughness, s.count, s.filter, s.amount)
+                  for s in a.statics) if a else []
+    return trig, stat
+
