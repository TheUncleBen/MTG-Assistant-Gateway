--- /dev/null
+++ b/tests/goldfish/test_known_answers.py
@@ -0,0 +1,307 @@
+"""Known-answer table: cases whose result was worked out by hand.
+
+Part 1 plays whole games where draws cannot matter (a commander and 99 copies
+of one basic land), so the turn each opponent dies follows from the rules
+alone: 3 opponents at 40 life, attacks always unblocked, focus fire on the
+first living opponent, 21 commander damage eliminates. Each case's comment
+shows the arithmetic.
+
+Part 2 reads real cards' rules text (Scryfall oracle text, copied 2026-10-21)
+and checks the model the templates produce, or that the card is left
+unmodeled. A change that moves any of these answers is a change in what the
+simulator does and must update the table on purpose.
+"""
+import pytest
+
+from mystic_forge.goldfish import autoderive
+from mystic_forge.goldfish.cards import SimCard, parse_cost
+from mystic_forge.goldfish.runner import play_one_game
+from tests.goldfish.helpers import make_data
+
+
+def _game(commander_data, until_turn=40):
+    cards = {
+        "Mountain": SimCard(data=make_data("Mountain", types=frozenset({"land"}),
+                                           produces={"R": 1}), ann=None, scope_class=None),
+        commander_data.name: SimCard(data=commander_data, ann=None, scope_class=None),
+    }
+    rec, log = play_one_game(cards, ["Mountain"] * 99, commander_data.name,
+                             game_seed=7, until_turn=until_turn, opponents=3)
+    return rec, log
+
+
+def _boss(**kw):
+    base = {"cost": parse_cost("{2}{R}"),
+            "types": frozenset({"creature", "legendary"}), "power": 3, "toughness": 3}
+    base.update(kw)
+    return make_data("Boss", **base)
+
+
+def test_plain_three_power_commander():
+    # Cast turn 3 (third Mountain), attacks from turn 4 for 3. Commander damage
+    # reaches 21 on the 7th hit: turn 10 (opponent 1), turns 11-17 (2), 18-24 (3).
+    rec, _ = _game(_boss())
+    assert rec.commander_cast_turn == 3
+    assert rec.cmdr21_turn == 10
+    assert rec.kill_turn == 10
+    assert rec.won_turn == 24
+
+
+def test_double_strike_commander():
+    # 3 power twice a hit = 6: 21 on the 4th hit. Turns 4-7, 8-11, 12-15.
+    rec, _ = _game(_boss(keywords=frozenset({"double strike"})))
+    assert rec.cmdr21_turn == 7
+    assert rec.won_turn == 15
+
+
+def test_haste_commander():
+    # {1}{R} 2/2 haste: cast and attacks turn 2. 21 on the 11th hit (22):
+    # turns 2-12, 13-23, 24-34.
+    rec, _ = _game(_boss(cost=parse_cost("{1}{R}"), power=2, toughness=2,
+                         keywords=frozenset({"haste"})))
+    assert rec.commander_cast_turn == 2
+    assert rec.cmdr21_turn == 12
+    assert rec.won_turn == 34
+
+
+def test_defender_commander_never_attacks():
+    rec, _ = _game(_boss(power=0, toughness=4, keywords=frozenset({"defender"})),
+                   until_turn=12)
+    assert rec.commander_cast_turn == 3
+    assert rec.won_turn is None
+    assert sum(rec.damage_by_turn) == 0
+
+
+def _derived(card):
+    return autoderive._derive_one({"keywords": [], **card})
+
+
+def test_anthem_on_the_commander_read_from_its_text():
+    # "Creatures you control get +1/+1." on a 3/3 commander: hits for 4, 21 on
+    # the 6th hit. Turns 4-9, 10-15, 16-21.
+    d = _derived({"name": "Boss", "type_line": "Legendary Creature — Soldier",
+                  "mana_cost": "{2}{R}", "power": "3", "toughness": "3",
+                  "oracle_text": "Creatures you control get +1/+1."})
+    assert d.auto_annotated and not d.needs_annotation
+    cards = {
+        "Mountain": SimCard(data=make_data("Mountain", types=frozenset({"land"}),
+                                           produces={"R": 1}), ann=None, scope_class=None),
+        "Boss": d.card,
+    }
+    rec, _ = play_one_game(cards, ["Mountain"] * 99, "Boss", game_seed=7,
+                           until_turn=30, opponents=3)
+    assert rec.cmdr21_turn == 9
+    assert rec.won_turn == 21
+
+
+def test_enters_trigger_drain_read_from_its_text():
+    # A 0/1 commander that drains each opponent for 3 on entering: turn 3, 9
+    # damage in all, never any combat damage.
+    d = _derived({"name": "Boss", "type_line": "Legendary Creature — Vampire",
+                  "mana_cost": "{2}{R}", "power": "0", "toughness": "1",
+                  "oracle_text": "When this creature enters, each opponent loses 3 life."})
+    cards = {
+        "Mountain": SimCard(data=make_data("Mountain", types=frozenset({"land"}),
+                                           produces={"R": 1}), ann=None, scope_class=None),
+        "Boss": d.card,
+    }
+    rec, _ = play_one_game(cards, ["Mountain"] * 99, "Boss", game_seed=7,
+                           until_turn=8, opponents=3)
+    assert rec.noncombat_damage_by_turn[2] == 9
+    assert sum(rec.noncombat_damage_by_turn) == 9
+    assert rec.won_turn is None
