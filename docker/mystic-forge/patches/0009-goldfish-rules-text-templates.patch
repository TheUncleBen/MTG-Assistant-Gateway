+def test_long_and_chains_read_quickly():
+    import time
+    from mystic_forge.goldfish import rules_text
+    t = time.monotonic()
+    assert rules_text.read_effect("x, then y and " * 40 + "z") is None
+    assert rules_text.read_effect(" and ".join(["x"] * 2000)) is None
+    assert time.monotonic() - t < 1.0
