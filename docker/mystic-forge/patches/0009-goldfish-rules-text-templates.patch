diff --git a/mystic_forge/goldfish/rules_text.py b/mystic_forge/goldfish/rules_text.py
new file mode 100644
index 0000000..430d2f8
--- /dev/null
+++ b/mystic_forge/goldfish/rules_text.py
@@ -0,0 +1,542 @@
+"""Rules-text templates: common card sentences read into the annotation DSL.
+
+autoderive's first-match branches model a card only when the whole card is
+one shape (a land, a rock, a pure draw spell...). Everything else used to be
+asked for an annotation and played as a blank body. This module reads the
+card sentence by sentence instead. Each sentence gets exactly one of four
+outcomes:
+
+- ``model``: read into DSL parts (triggers, statics, activated abilities),
+  validated by cards.validate_annotations like any client annotation.
+- ``free``: has no effect in a goldfish game, where nothing blocks, nothing
+  dies and no opponent acts (flying, "can't block", a dies trigger...).
+  Some carry an approximation note (lifelink's life is not counted).
+- ``aside``: interaction with opponents' cards (removal, counters, bounce).
+  A goldfish table has nothing for it to hit; the card is still cast when it
+  is a permanent, and is counted in the honesty report's out-of-scope class.
+- ``unknown``: no template. One unknown sentence keeps the card in
+  "needs annotation"; its modeled sentences still play.
+
+``read_card`` never guesses: a sentence is ``unknown`` unless a template
+matches the whole sentence.
+"""
+from __future__ import annotations
+
+import re
+from functools import lru_cache
+from dataclasses import dataclass, field
+
+NUM_WORDS = {"a": 1, "an": 1, "one": 1, "two": 2, "three": 3, "four": 4,
+             "five": 5, "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10}
+NUM = r"(a|an|one|two|three|four|five|six|seven|eight|nine|ten|\d+)"
+PT = r"([+-]\d+)/([+-]\d+)"
+COST = r"((?:\{[^}]+\}(?:,\s*)?)+)"
+
+# Keywords with no effect in a goldfish game: no blockers, no opponent
+# spells or removal, nothing dies.
+FREE_KEYWORDS = frozenset({
+    "flying", "reach", "trample", "menace", "deathtouch", "first strike",
+    "vigilance", "flash", "hexproof", "indestructible", "shroud", "fear",
+    "intimidate", "shadow", "skulk", "horsemanship", "changeling", "devoid",
+    "partner", "choose a background", "friends forever", "banding",
+    "can't be blocked", "persist", "undying", "split second",
+})
+# Keywords the engine reads from the card's own keyword list.
+ENGINE_KEYWORDS = frozenset({"haste", "double strike", "defender"})
+# Keywords read into a model (a keyword-only creature is not vanilla).
+MODELED_KEYWORDS = frozenset({"prowess"})
+# Free, but the report says what is left out.
+NOTED_KEYWORDS = {
+    "lifelink": "lifelink: life gained from combat damage is not counted",
+    "cycling": "unused-option: cycling is never used; the card is cast",
+    "flashback": "unused-option: flashback is never used",
+    "kicker": "unused-option: the kicker cost is never paid",
+    "multikicker": "unused-option: the kicker cost is never paid",
+    "buyback": "unused-option: buyback is never paid",
+    "entwine": "unused-option: entwine is never paid",
+    "evoke": "unused-option: evoke is never used; the card is cast",
+    "ninjutsu": "unused-option: ninjutsu is never used; the card is cast",
+    "madness": "unused-option: madness is never used",
+}
+SCRY_NOTE = "library-order: scry and surveil do not change the library order"
+DIES_NOTE = "no-deaths: nothing dies in a goldfish game, so this never happens"
+ATTACK_NOTE = ("attack-trigger: fires whenever you attack, which the policy "
+               "does with every creature that can")
+OTHER_NOTE = "anthem-self: 'other' is not modeled; the bonus includes this card"
+
+ASIDE_PATTERNS = (
+    (r"\b(destroy|exile) (up to \w+ )?(another )?target\b", "interaction_removal"),
+    (r"\b(destroy|exile) all\b", "interaction_wipe"),
+    (r"\beach (player|opponent) sacrifices\b", "interaction_wipe"),
+    (r"\bdeals? \w+ damage to each creature\b", "interaction_wipe"),
+    (r"\ball creatures get -", "interaction_wipe"),
+    (r"\bcounter target\b", "interaction_counter"),
+    (r"\bdeals? \w+ damage to (up to \w+ )?(another )?target creature\b", "interaction_removal"),
+    (r"\btarget creature( an opponent controls| you don't control)? gets -", "interaction_removal"),
+    (r"\breturn (up to \w+ )?target [^.]*to (its|their) owner'?s'? hands?\b", "interaction_removal"),
+    (r"\btap (up to \w+ )?target\b", "interaction_removal"),
+    (r"\btarget creature( an opponent controls)? can't block\b", "interaction_removal"),
+    (r"\bfights?\b", "interaction_removal"),
+)
+FREE_SENTENCES = tuple(re.compile(p, re.IGNORECASE) for p in (
+    r"CARDNAME can't block",
+    r"CARDNAME can't be (blocked|countered)( except by [^.]*)?",
+    r"this spell can't be countered",
+    r"activate only (as a sorcery|during your turn)",
+    r"you have no maximum hand size",
+    r"you may choose new targets for the copy",
+    r"CARDNAME attacks each combat if able",
+    r"creatures you control have (flying|trample|vigilance|menace|reach|deathtouch|"
+    r"first strike|hexproof|indestructible|lifelink|ward \{\d+\})",
+))
+# Your own life total is not tracked: opponents never attack in a goldfish game.
+OWN_LIFE = re.compile(r"^you lose \w+ life$|^CARDNAME deals \w+ damage to you$",
+                      re.IGNORECASE)
+OWN_LIFE_NOTE = "own-life: your life total is not tracked in a goldfish game"
+MONARCH = re.compile(r"^(when|whenever) CARDNAME enters( the battlefield)?, you become the monarch$",
+                     re.IGNORECASE)
+MONARCH_NOTE = ("monarch: nobody takes it from you at a goldfish table, so it is "
+                "one more card each turn, drawn at your upkeep instead of your end step")
+KEYWORD_COSTED = re.compile(
+    r"^(?:(ward|equip|cycling|flashback|kicker|multikicker|buyback|entwine|evoke|"
+    r"ninjutsu|madness)(?: ?(?:\{[^}]+\})+| ?\u2014[^,;]+)"
+    r"|(crew) \d+|(protection from) [a-z ]+|([a-z]+walk)|(partner with) [^,;]+)$",
+    re.IGNORECASE)
+
+
+@dataclass
+class Reading:
+    triggers: list = field(default_factory=list)
+    statics: list = field(default_factory=list)
+    activated: list = field(default_factory=list)
+    notes: list = field(default_factory=list)
+    aside: str | None = None          # first interaction class seen
+    unknown: list = field(default_factory=list)
+
+    @property
+    def parts(self) -> bool:
+        return bool(self.triggers or self.statics or self.activated)
+
+    def annotation(self, name: str) -> dict:
+        return {"name": name, "triggers": self.triggers,
+                "statics": self.statics, "activated": self.activated}
+
+
+def _n(word: str) -> int:
+    w = word.lower()
+    return int(w) if w.isdigit() else NUM_WORDS.get(w, 1)
+
+
+def _pt(p: str, t: str) -> tuple[int, int]:
+    return int(p), int(t)
+
+
+def normalise(text: str, name: str) -> str:
+    """Reminder text dropped, the card's own name (and its short name before
+    a comma, and 'this creature/artifact/...') read as CARDNAME."""
+    text = re.sub(r"\([^)]*\)", "", text)
+    for n in sorted({name, name.split(",")[0]}, key=len, reverse=True):
+        if n:
+            text = text.replace(n, "CARDNAME")
+    text = re.sub(r"\bthis (creature|artifact|enchantment|permanent|land|"
+                  r"vehicle|planeswalker|spell|card|equipment|aura)\b",
+                  "CARDNAME", text, flags=re.IGNORECASE)
+    lines = (" ".join(ln.split()) for ln in text.splitlines())
+    return "\n".join(ln for ln in lines if ln)
+
+
+def _sentences(line: str) -> list[str]:
+    # Quoted abilities granted to something else stay one sentence.
+    out, buf, quoted = [], "", False
+    for ch in line:
+        buf += ch
+        if ch in "\"“”":
+            quoted = not quoted
+        if ch == "." and not quoted:
+            out.append(buf.strip())
+            buf = ""
+    if buf.strip():
+        out.append(buf.strip())
+    return [s.rstrip(".").strip() for s in out if s.strip(" .")]
+
+
+# -- effects -----------------------------------------------------------------
+
+_EFFECTS: list[tuple[re.Pattern, object]] = []
+
+
+def _effect(pattern: str):
+    def deco(fn):
+        _EFFECTS.append((re.compile(r"^" + pattern + r"$", re.IGNORECASE), fn))
+        return fn
+    return deco
+
+
+@_effect(rf"(you may )?draw {NUM} cards?")
+def _draw(m):
+    return [{"do": "draw", "count": _n(m.group(2))}]
+
+
+@_effect(rf"you draw {NUM} cards? and (you )?lose {NUM} life")
+def _arena(m):
+    return [{"do": "draw", "count": _n(m.group(1))}]     # the life: OWN_LIFE_NOTE
+
+
+@_effect(rf"(you may )?draw {NUM} cards?, then discard {NUM} cards?")
+def _loot(m):
+    # Discard is not modeled: the hand keeps the extra cards.
+    return None
+
+
+@_effect(rf"you gain {NUM} life")
+def _gain(m):
+    return [{"do": "gain_life", "count": _n(m.group(1))}]
+
+
+@_effect(rf"(you may )?create {NUM} (tapped )?treasure tokens?")
+def _treasure(m):
+    return [{"do": "treasure", "count": _n(m.group(2))}]
+
+
+@_effect(rf"(you may )?create {NUM} (tapped )?(\d+)/(\d+) [a-z ]*?creature tokens?"
+         rf"( with ([a-z ,]+?))?( named [^.]+)?")
+def _token(m):
+    if m.group(3):
+        return None                     # tapped tokens: not modeled
+    kws = ()
+    if m.group(7):
+        kws = tuple(k.strip() for k in re.split(r",| and ", m.group(7).lower()) if k.strip())
+        if any(k not in FREE_KEYWORDS | ENGINE_KEYWORDS | set(NOTED_KEYWORDS) for k in kws):
+            return None
+    return [{"do": "create_token", "count": _n(m.group(2)),
+             "power": int(m.group(4)), "toughness": int(m.group(5)),
+             "keywords": [k for k in kws if k in ENGINE_KEYWORDS]}]
+
+
+@_effect(rf"CARDNAME deals {NUM} damage to (any target|target player|target opponent|"
+         rf"target player or planeswalker|target opponent or planeswalker|each opponent|"
+         rf"each player)")
+def _damage(m):
+    target = "one_opponent" if m.group(2).lower().startswith("target") or \
+        m.group(2).lower() == "any target" else "each_opponent"
+    return [{"do": "damage", "count": _n(m.group(1)), "target": target}]
+
+
+@_effect(rf"(each opponent|target opponent|target player) loses {NUM} life"
+         rf"( and you gain {NUM} life)?")
+def _drain(m):
+    target = "each_opponent" if m.group(1).lower() == "each opponent" else "one_opponent"
+    out = [{"do": "damage", "count": _n(m.group(2)), "target": target}]
+    if m.group(3):
+        out.append({"do": "gain_life", "count": _n(m.group(4))})
+    return out
+
+
+@_effect(rf"put {NUM} \+1/\+1 counters? on CARDNAME")
+def _counters(m):
+    n = _n(m.group(1))
+    return [{"do": "pump", "power": n, "toughness": n, "duration": "permanent"}]
+
+
+@_effect(rf"CARDNAME gets {PT} until end of turn")
+def _self_pump(m):
+    p, t = _pt(m.group(1), m.group(2))
+    return [{"do": "pump", "power": p, "toughness": t}]
+
+
+@_effect(r"(you may )?search your library for (a|up to one|up to two|two) (basic land|basic "
+         r"forest|basic island|basic plains|basic swamp|basic mountain|forest|island|plains|"
+         r"swamp|mountain) cards?"
+         r"( and/or [^,]+)?, (reveal (it|them), )?put (it|them|that card|those cards) onto "
+         r"the battlefield( tapped)?, then shuffle")
+def _ramp(m):
+    return [{"do": "ramp_land", "count": 2 if "two" in m.group(2).lower() else 1}]
+
+
+@_effect(r"(you may )?search your library for an? (forest|island|plains|swamp|mountain|"
+         r"basic land) card, put (it|that card) onto the battlefield( tapped)?, then shuffle")
+def _ramp_one(m):
+    return [{"do": "ramp_land", "count": 1}]
+
+
+@_effect(r"(you may )?search your library for an? (creature|artifact|enchantment|instant|"
+         r"sorcery|land|planeswalker|equipment)? ?card, (reveal it, )?put (it|that card) "
+         r"into your hand, then shuffle")
+def _tutor(m):
+    return [{"do": "tutor", "filter": (m.group(2) or "any").lower()}]
+
+
+@_effect(r"add ((?:\{[WUBRGC]\})+)")
+def _ritual(m):
+    return [{"do": "add_mana", "pips": m.group(1)}]
+
+
+@_effect(rf"(scry|surveil) {NUM}")
+def _scry(m):
+    return []                           # free, noted by the caller
+
+
+@_effect(r"after this (main )?phase, there is an additional combat phase"
+         r"( followed by an additional main phase)?")
+def _extra_combat(m):
+    return [{"do": "extra_combat"}]
+
+
+# An effect joined from more parts than this is not read (and the search stays short).
+MAX_JOINS = 6
+
+
+def read_effect(text: str) -> list | None:
+    """DSL verb dicts (no ``on``) for one effect clause, or None."""
+    text = text.strip().rstrip(".")
+    if text.count(" and ") + text.count(", then ") > MAX_JOINS:
+        return None
+    found = _read_effect(text)
+    return [dict(v) for v in found] if found is not None else None
+
+
+@lru_cache(maxsize=4096)
+def _read_effect(text: str) -> tuple | None:
+    found = _read_effect_uncached(text)
+    return tuple(found) if found is not None else None
+
+
+def _read_effect_uncached(text: str) -> list | None:
+    for pat, fn in _EFFECTS:
+        m = pat.match(text)
+        if m:
+            return fn(m)
+    for sep in (", then ", " and "):
+        if sep in text:
+            left, right = text.split(sep, 1)
+            a, b = _read_effect(left.strip().rstrip(".")), _read_effect(right.strip().rstrip("."))
+            if a is not None and b is not None:
+                return list(a) + list(b)
+    return None
+
+
+# -- whole sentences -----------------------------------------------------------
+
+_TRIGGER_HEADS = (
+    (r"(when|whenever) CARDNAME enters( the battlefield)?( or attacks)?", ("etb",)),
+    (r"(when|whenever) CARDNAME enters( the battlefield)? or dies", ("etb",)),
+    (r"when you cast (this spell|CARDNAME)", ("cast",)),
+    (r"at the beginning of your upkeep", ("upkeep",)),
+    (r"at the beginning of combat on your turn", ("combat_begin",)),
+    (r"whenever (CARDNAME|you) attacks?", ("attack",)),
+    (r"whenever CARDNAME deals combat damage to (a player|an opponent)", ("attack",)),
+    (r"whenever (another creature|a creature|another nontoken creature|a nontoken creature) "
+     r"(you control )?enters( the battlefield)?( under your control)?", ("creature_etb",)),
+    (r"whenever a land (you control )?enters( the battlefield)?( under your control)?",
+     ("land_etb",)),
+    (r"whenever an equipment (you control )?enters( the battlefield)?( under your control)?",
+     ("equipment_etb",)),
+    (r"whenever you cast an? (noncreature|instant or sorcery|) ?spell", ("spell_cast",)),
+)
+_HEADS = [(re.compile(r"^" + p + r", (.+)$", re.IGNORECASE), ev) for p, ev in _TRIGGER_HEADS]
+_DIES = re.compile(r"^(when|whenever) [^,]*(dies|is put into (a|your) graveyard)\b",
+                   re.IGNORECASE)
+# Ability words (the label before "—" that has no rules meaning; the sentence after it says it
+# all). Any other label (Boast, Exhaust, Max speed) is a keyword whose limit is in its reminder
+# text, which normalise drops, so its sentence is left unread.
+ABILITY_WORDS = frozenset((
+    "adamant", "addendum", "alliance", "battalion", "bloodrush", "celebration", "channel",
+    "chroma", "cohort", "constellation", "converge", "corrupted", "council's dilemma", "coven",
+    "delirium", "descend 4", "descend 8", "domain", "eerie", "eminence", "enrage",
+    "fateful hour", "fathomless descent", "ferocious", "flurry", "formidable", "grandeur",
+    "hellbent", "heroic", "imprint", "inspired", "join forces", "kinship", "landfall",
+    "lieutenant", "magecraft", "metalcraft", "morbid", "pack tactics", "paradox", "parley",
+    "radiance", "raid", "rally", "revolt", "secret council", "spell mastery", "strive",
+    "survival", "sweep", "tempting offer", "threshold", "undergrowth", "valiant",
+    "will of the council",
+))
+_ABILITY_WORD = re.compile(r"^([A-Za-z0-9' ]+) — ")
+_ENTERS_OR_DIES = re.compile(r"^(when|whenever) CARDNAME enters( the battlefield)? or dies, ",
+                             re.IGNORECASE)
+# An unread sentence that limits or changes the card's other sentences: what was read must not
+# play without it.
+LIMITING = re.compile(r"^(activate |this ability |if you do|otherwise|instead|spend this mana "
+                      r"only|[^—]+ — )|\bonly once\b", re.IGNORECASE)
+_STATIC = (
+    (re.compile(rf"^(other )?creatures you control get {PT}( and have ([a-z ,]+))?$",
+                re.IGNORECASE), "anthem"),
+    (re.compile(r"^creatures you control have haste$", re.IGNORECASE), "haste_anthem"),
+    (re.compile(r"^you may play an additional land on each of your turns$", re.IGNORECASE),
+     "extra_land"),
+    (re.compile(r"^(instant and sorcery|noncreature|creature|artifact|equipment) spells you "
+                r"cast cost \{(\d+)\} less to cast$", re.IGNORECASE), "cost_reduction"),
+    (re.compile(r"^if an effect would create one or more tokens under your control, it "
+                r"creates twice that many of those tokens instead$", re.IGNORECASE),
+     "token_doubling"),
+    (re.compile(r"^equipped creature gets \+(\d+)/\+(\d+)$", re.IGNORECASE), "equip_grant"),
+)
+_COST_FILTERS = {"instant and sorcery": "instant_or_sorcery", "noncreature": "noncreature",
+                 "creature": "creature", "artifact": "artifact", "equipment": "equipment"}
+_ACTIVATED = re.compile(r"^((?:\{[^}]+\}(?:, )?)+): (.+)$")
+
+
+def _keyword_sentence(s: str, out: Reading) -> bool:
+    """A sentence that is only keywords (``Flying, haste``)."""
+    toks = [t.strip() for t in re.split(r",|;", s) if t.strip()]
+    if not toks:
+        return False
+    notes = []
+    for t in toks:
+        low = t.lower()
+        if low in FREE_KEYWORDS or low in ENGINE_KEYWORDS:
+            continue
+        if low == "prowess":
+            out.triggers.append({"on": "spell_cast", "filter": "noncreature",
+                                 "do": "pump", "power": 1, "toughness": 1})
+            continue
+        head = KEYWORD_COSTED.match(low)
+        if head:
+            word = next(g for g in head.groups() if g)
+            if word in NOTED_KEYWORDS:
+                notes.append(NOTED_KEYWORDS[word])
+            elif word in ("crew", "equip", "partner with") or word.endswith("walk") \
+                    or word in ("ward", "protection from"):
+                pass
+            else:
+                return False
+            continue
+        if low in NOTED_KEYWORDS:
+            notes.append(NOTED_KEYWORDS[low])
+            continue
+        return False
+    out.notes.extend(notes)
+    return True
+
+
+def read_sentence(s: str, out: Reading, *, permanent: bool) -> str:
+    """Read one sentence into ``out``; returns its outcome."""
+    label = _ABILITY_WORD.match(s)
+    if label and label.group(1).lower() in ABILITY_WORDS:
+        s = s[label.end():].strip()
+    low = s.lower()
+    if _keyword_sentence(s, out):
+        return "model"
+    if any(p.fullmatch(s) for p in FREE_SENTENCES):
+        return "free"
+    if OWN_LIFE.match(s):
+        out.notes.append(OWN_LIFE_NOTE)
+        return "free"
+    if MONARCH.match(s):
+        out.triggers.append({"on": "upkeep", "do": "draw", "count": 1})
+        out.notes.append(MONARCH_NOTE)
+        return "model"
+    if _DIES.match(s) and not _ENTERS_OR_DIES.match(s):
+        out.notes.append(DIES_NOTE)
+        return "free"
+    for pat, kind in _STATIC:
+        m = pat.match(s)
+        if not m:
+            continue
+        if kind == "anthem":
+            kws = tuple(k.strip() for k in re.split(r",| and ", (m.group(5) or "").lower())
+                        if k.strip())
+            if any(k not in FREE_KEYWORDS | ENGINE_KEYWORDS for k in kws):
+                return "unknown"
+            if m.group(1):
+                out.notes.append(OTHER_NOTE)
+            out.statics.append({"kind": "anthem", "power": int(m.group(2)),
+                                "toughness": int(m.group(3)),
+                                "keywords": [k for k in kws if k in ENGINE_KEYWORDS]})
+        elif kind == "haste_anthem":
+            out.statics.append({"kind": "anthem", "keywords": ["haste"]})
+        elif kind == "extra_land":
+            out.statics.append({"kind": "extra_land_drops", "count": 1})
+        elif kind == "cost_reduction":
+            out.statics.append({"kind": "cost_reduction",
+                                "filter": _COST_FILTERS[m.group(1).lower()],
+                                "amount": int(m.group(2))})
+        elif kind == "token_doubling":
+            out.statics.append({"kind": "token_doubling"})
+        else:
+            return "unknown"              # equipment grants belong to autoderive
+        return "model"
+    for pat, events in _HEADS:
+        m = pat.match(s)
+        if not m:
+            continue
+        verbs = read_effect(m.group(m.lastindex))
+        if verbs is None:
+            break
+        for ev in events:
+            for v in verbs:
+                t = {"on": ev, **v}
+                if ev == "spell_cast":
+                    kind = re.search(r"cast an? (noncreature|instant or sorcery)", low)
+                    if kind:
+                        t["filter"] = ("noncreature" if kind.group(1) == "noncreature"
+                                       else "instant_or_sorcery")
+                    if v["do"] == "tutor":
+                        return "unknown"
+                out.triggers.append(t)
+        if events == ("attack",):
+            out.notes.append(ATTACK_NOTE)
+        if _ENTERS_OR_DIES.match(s):
+            out.notes.append(DIES_NOTE)
+        if " or attacks" in low and events == ("etb",):
+            for v in verbs:
+                out.triggers.append({"on": "attack", **v})
+            out.notes.append(ATTACK_NOTE)
+        if re.match(r"^(scry|surveil)", m.group(m.lastindex), re.IGNORECASE):
+            out.notes.append(SCRY_NOTE)
+        if re.search(r"\blose \w+ life$", m.group(m.lastindex), re.IGNORECASE):
+            out.notes.append(OWN_LIFE_NOTE)
+        return "model"
+    m = _ACTIVATED.match(s)
+    if m and permanent:
+        cost = m.group(1).replace(", ", "")
+        if not re.fullmatch(r"(\{(\d+|[WUBRGC]|T)\})+", cost):
+            return _aside_or_unknown(s, out)
+        verbs = read_effect(m.group(2))
+        if verbs is None:
+            return _aside_or_unknown(s, out)
+        for v in verbs:
+            if v["do"] in ("add_mana",):
+                return "unknown"           # mana abilities belong to autoderive
+            out.activated.append({"cost": cost, **v})
+        if re.match(r"^(scry|surveil)", m.group(2), re.IGNORECASE):
+            out.notes.append(SCRY_NOTE)
+        return "model"
+    if not permanent:
+        verbs = read_effect(s)
+        if verbs is not None:
+            for v in verbs:
+                out.triggers.append({"on": "cast", **v})
+            if re.match(r"^(scry|surveil)", s, re.IGNORECASE):
+                out.notes.append(SCRY_NOTE)
+            return "model"
+    return _aside_or_unknown(s, out)
+
+
+def _aside_or_unknown(s: str, out: Reading) -> str:
+    low = s.lower()
+    for pat, cls in ASIDE_PATTERNS:
+        if re.search(pat, low):
+            # Only when the whole sentence is the interaction: a rider
+            # ("..., then draw a card") would be lost otherwise.
+            rest = re.split(r", then |\. ", low, maxsplit=1)
+            if len(rest) > 1:
+                return "unknown"
+            out.aside = out.aside or cls
+            return "aside"
+    out.unknown.append(s)
+    return "unknown"
+
+
+def read_card(oracle: str, name: str, *, permanent: bool) -> Reading:
+    """Read a card's whole rules text (one face). ``permanent`` is False for
+    instants and sorceries, whose sentences are cast effects."""
+    out = Reading()
+    for line in normalise(oracle, name).splitlines():
+        if re.match(r"^(•|•)|^choose (one|two|one or more|any number)", line,
+                    re.IGNORECASE):
+            out.unknown.append(line)       # modal spells: not modeled
+            continue
+        for s in _sentences(line):
+            read_sentence(s, out, permanent=permanent)
+    out.notes = list(dict.fromkeys(out.notes))
+    return out
