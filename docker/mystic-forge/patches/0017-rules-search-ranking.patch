+++ b/tests/test_rules_search_ranking.py
@@ -0,0 +1,43 @@
+"""rules_search ranks the rule an assistant is after near the top: a rare term
+counts for more than a common one, terms close together count for more than
+terms far apart, and a term that names the rule's section counts too (found in
+the assistant tool review, 2026-10-28: "commander damage" had 903.10a outside
+the top 5). Checked on the vendored Comprehensive Rules."""
+from pathlib import Path
+
+import pytest
+
+from mystic_forge import rulebook
+
+CR = Path(__file__).resolve().parent.parent / "mystic_forge" / "data" / "MagicCompRules.txt"
+
+
+@pytest.fixture(scope="module")
+def idx():
+    return rulebook.parse(CR.read_text(encoding="utf-8"))
+
+
+def _top(idx, query, n=5):
+    hits, _total = idx.search(query, n)
+    return [h.ref for h in hits]
+
+
+def test_commander_damage_finds_the_21_damage_rules(idx):
+    top = _top(idx, "commander damage")
+    assert "903.10a" in top and "704.6c" in top, top
+
+
+def test_commander_tax_finds_its_rule_and_glossary_entry(idx):
+    top = _top(idx, "commander tax", 2)
+    assert set(top) == {"903.8", "Commander Tax"}, top
+
+
+def test_a_single_keyword_still_leads_with_its_own_rules(idx):
+    assert set(_top(idx, "deathtouch", 3)) <= {"702.2", "702.2a", "702.2b", "702.2c", "702.2d", "Deathtouch"}
+    assert "Trample" in _top(idx, "trample", 3)
+
+
+def test_the_total_still_counts_every_entry_with_any_term(idx):
+    _hits, total = idx.search("commander damage", 5)
+    _hits, alone = idx.search("commander", 5)
+    assert total >= alone
