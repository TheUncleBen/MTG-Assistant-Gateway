+def _near(tokens: list[str], terms: set[str], window: int) -> bool:
+    """Whether every one of `terms` occurs within `window` consecutive tokens."""
+    at = [i for i, t in enumerate(tokens) if t in terms]
+    for k, i in enumerate(at):
+        seen = set()
+        for j in at[k:]:
+            if j >= i + window:
+                break
+            seen.add(tokens[j])
+        if seen == terms:
+            return True
+    return False
