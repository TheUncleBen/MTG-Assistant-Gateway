<?xml version="1.0" encoding="utf-8"?>
<!-- The package ID is not here: android/app/build.gradle.kts reads it from android/app/application-id.txt,
     the one place to change it. The applinks flavor adds an App Links intent filter from
     src/applinks/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The app installs its own updates from the project's GitHub releases (Updater.kt). Android asks
         the person once to allow installs from this app; from Android 12 an app updating itself may
         then skip the confirmation, which is what the second permission asks for. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The app reloads a page that failed to load once the phone's network comes back (Q63,
         MainActivity.watchNetwork). A normal permission: granted at install, never asked. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notifications (NotifyService): the member's messages, the foreground service that keeps the
         connection to the gateway open while the app is closed, starting it again after a restart,
         a wake lock while a message is posted, and asking once to run in the background so Android's
         battery saving doesn't cut the connection. POST_NOTIFICATIONS is asked when the member presses
         Get notifications on this phone; the others are granted at install. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Without this the CAMERA permission would imply a required camera and hide the app from
         devices without one. The app works without a camera; scanning just isn't offered. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Nothing the app stores leaves the phone: sign-in cookies and page storage live under
         app_webview/. allowBackup=false covers Android 11 and earlier; from Android 12 it no longer
         stops device-to-device transfer, so dataExtractionRules excludes everything from both cloud
         backup and transfer, and fullBackupContent does the same for anything that ignores the flag. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MtgAssistantGateway"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="true">

        <!-- The launcher shows the activity's label, so the short name goes here; the application's
             full name stays for Settings and the app info page. A Light/Dark switch (uiMode) does not
             recreate the activity at once, which would reload the page in use; MainActivity redraws
             at the next page load. -->
        <activity
            android:name="local.mtgassistantgateway.app.MainActivity"
            android:label="@string/launcher_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press shortcuts to My decks, Scan cards and Proposals (res/xml/shortcuts.xml). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- The phone's browser handing a sign-in back (BrowserSignIn.kt). The gateway's page
                 opens it through an intent: link naming this app's package. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mtgassistant-signin" android:host="signin" />
            </intent-filter>
            <!-- A gateway link shared to the app (from the browser's share sheet, say) opens there. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name="local.mtgassistantgateway.app.SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The member's notifications while the app is closed: one connection to the gateway's own
             address, no Google push service. specialUse: none of Android's other service types fits
             a connection to a self-hosted server that receives notifications. -->
        <service
            android:name="local.mtgassistantgateway.app.NotifyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a connection open to the self-hosted gateway the person signs in to, so they receive its notifications without Google push services." />
        </service>
        <!-- Starts NotifyService again after the phone restarts and after the app is updated. -->
        <receiver
            android:name="local.mtgassistantgateway.app.NotifyService$Restart"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- PackageInstaller's answer to an update (Updater.kt). Not exported: only the install
             session's own PendingIntent reaches it. -->
        <receiver
            android:name="local.mtgassistantgateway.app.Updater$InstallResultReceiver"
            android:exported="false" />

    </application>
</manifest>
