<?xml version="1.0" encoding="utf-8"?>
<!-- Text of the camera sheet's toggles: dark on the orange fill while on, the sheet's light text while off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/cam_text_muted" />
    <item android:state_checked="true" android:color="@color/on_accent" />
    <item android:color="@color/cam_text" />
</selector>
