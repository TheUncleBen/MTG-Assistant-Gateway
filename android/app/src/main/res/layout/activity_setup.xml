<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal">
        <!-- the pages' top bar -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="50dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@color/navbar" android:paddingStart="12dp" android:paddingEnd="12dp">
            <ImageView
                android:layout_width="25dp" android:layout_height="25dp"
                android:src="@drawable/ic_launcher_foreground" android:contentDescription="@null"
                android:background="@drawable/button_primary_bg" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textColor="#ffffff" android:textSize="16sp"
                android:textStyle="bold" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" style="@style/SetupColumn"
            android:background="@drawable/card_bg" android:padding="16dp" android:layout_margin="16dp"
            android:layout_marginTop="32dp">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/setup_title" android:textColor="@color/text" android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/setup_blurb" android:textColor="@color/text_muted" android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/setup_label" android:textColor="@color/text" android:textSize="13sp"
                android:textStyle="bold" android:layout_marginTop="20dp" />
            <EditText android:id="@+id/gateway_url"
                android:layout_width="match_parent" android:layout_height="39dp"
                android:layout_marginTop="6dp" android:hint="@string/setup_hint"
                android:inputType="textUri" android:imeOptions="actionGo" android:singleLine="true"
                android:background="@drawable/input_bg" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:textSize="14sp"
                android:textColor="@color/text" android:textColorHint="@color/text_muted" android:autofillHints="url" />
            <TextView android:id="@+id/setup_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textSize="14sp" android:visibility="gone" />
            <Button android:id="@+id/setup_continue"
                android:layout_width="match_parent" android:layout_height="39dp"
                android:layout_marginTop="20dp" android:text="@string/setup_continue"
                android:background="@drawable/button_primary_bg" android:textColor="@color/on_accent"
                android:textAllCaps="false" android:textStyle="bold" android:textSize="14sp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
