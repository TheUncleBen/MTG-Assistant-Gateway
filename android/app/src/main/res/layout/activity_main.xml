<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView android:id="@+id/web"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <ProgressBar android:id="@+id/progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:layout_gravity="top" android:progressTint="@color/accent"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/error_box"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="32dp"
        android:background="@color/bg" android:visibility="gone">
        <TextView android:id="@+id/error_text"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="16sp" android:gravity="center"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/error_retry"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="120dp"
            android:layout_marginTop="16dp" android:text="@string/retry" android:textAllCaps="false"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:textStyle="bold"
            android:background="@drawable/button_primary_bg" android:textColor="@color/button_primary_text"
            android:stateListAnimator="@null" />
        <!-- The way out when the saved gateway never loads: the page's own menu is under this box
             and the floating menu button is hidden over gateway pages. -->
        <Button android:id="@+id/error_change"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="120dp" android:layout_marginTop="8dp"
            android:text="@string/menu_gateway" android:textAllCaps="false"
            android:textColor="@color/text" />
    </LinearLayout>

    <!-- A newer version of the app is out (Updater.kt): one tap installs it. Over the page's top
         bar until Update or Later is tapped. -->
    <LinearLayout android:id="@+id/update_bar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:layout_margin="8dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="12dp" android:background="@drawable/card_bg" android:elevation="8dp"
        android:visibility="gone" android:accessibilityLiveRegion="polite">
        <TextView android:id="@+id/update_text"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="15sp" />
        <Button android:id="@+id/update_later"
            android:layout_width="wrap_content" android:layout_height="39dp"
            android:layout_marginStart="8dp" android:text="@string/update_later" android:textAllCaps="false"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:minWidth="48dp"
            android:background="@android:color/transparent" android:textColor="@color/text"
            android:stateListAnimator="@null" />
        <Button android:id="@+id/update_now"
            android:layout_width="wrap_content" android:layout_height="39dp"
            android:layout_marginStart="4dp" android:text="@string/update_now" android:textAllCaps="false"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:textStyle="bold" android:minWidth="48dp"
            android:background="@drawable/button_primary_bg" android:textColor="@color/on_accent"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <ImageButton android:id="@+id/fab"
        android:layout_width="52dp" android:layout_height="52dp"
        android:layout_gravity="bottom|end" android:layout_margin="16dp"
        android:background="@drawable/fab_bg" android:src="@drawable/ic_menu"
        android:contentDescription="@string/fab_label" android:elevation="6dp" />
</FrameLayout>
