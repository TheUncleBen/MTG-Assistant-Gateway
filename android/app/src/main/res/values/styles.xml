<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phones: the setup form fills the width. -->
    <style name="SetupColumn" />

    <!-- The camera sheet's buttons, drawn like the pages' buttons (theme.py): sentence case, 48dp
         tall, 3dp corners. Plain is the outline button; Toggle is the outline that fills orange
         while checked. Shoot (shutter_bg) stays the row's one primary button. -->
    <style name="CameraButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="CameraButton.Plain">
        <item name="android:background">@drawable/button_plain_bg</item>
        <item name="android:textColor">@color/button_plain_text</item>
    </style>
    <style name="CameraButton.Toggle">
        <item name="android:background">@drawable/button_toggle_bg</item>
        <item name="android:textColor">@color/button_toggle_text</item>
    </style>
</resources>
