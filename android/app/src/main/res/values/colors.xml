<?xml version="1.0" encoding="utf-8"?>
<!-- The gateway's own palette (src/mtg_gateway/theme.py, Archidekt-style light theme). The
     dark set lives in values-night; the WebView pages pick their scheme the same way. -->
<resources>
    <color name="bg">#f9fafb</color>
    <color name="surface">#fafafa</color>
    <color name="surface_2">#dedede</color>
    <color name="border">#bababa</color>
    <color name="text">#383838</color>
    <color name="text_muted">#5e5e5e</color>
    <color name="accent">#fa890d</color>
    <!-- Dark text on the orange fill (theme.py on-orange token): 7.8:1; white on it is only 2.4:1. -->
    <color name="on_accent">#111111</color>
    <color name="danger">#b3262e</color>
    <color name="navbar">#313131</color>
    <color name="navbar_text">#ffffff</color>
    <color name="toolbar">#dcdcdc</color>
    <color name="icon_bg">#1c1f26</color>
    <color name="scrim">#99000000</color>
    <!-- The camera screen is dark in both themes (black viewfinder, dark scrim), so its text takes
         the dark palette whatever the phone's setting. No values-night counterpart on purpose. -->
    <color name="cam_bg">#181818</color>
    <color name="cam_text">#e3e3e3</color>
    <color name="cam_text_muted">#a8a8a8</color>
    <!-- Pressed state of the orange buttons: a dark ripple over the fill. -->
    <color name="ripple_on_accent">#33000000</color>
</resources>
