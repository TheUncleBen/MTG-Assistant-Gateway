<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher shortcuts (long-press the app icon), as the gateway's web manifest has them; its
     Watchlist is added by the app itself while the gateway's watchlists are on (MainActivity,
     GatewayUrl.DYNAMIC_SHORTCUTS), since a static shortcut cannot ask.
     Static, so they show even before the app has run. Each opens MainActivity naming a page;
     the app opens that page on the saved gateway, or the address screen before setup
     (GatewayUrl.SHORTCUTS, MainActivity.takeLink). targetPackage is the package ID written out:
     Android reads these intents without the app's own resources, so it cannot come from a string
     resource. It must match application-id.txt (GatewayUrlTest checks it). The IDs differ from
     the dynamic shortcuts of earlier versions (decks, scan, proposals): Android skips a manifest
     shortcut whose ID a dynamic one already holds. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="page_decks"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_decks">
        <intent
            android:action="local.mtgassistantgateway.app.OPEN_PAGE"
            android:targetPackage="local.mtgassistantgateway.app"
            android:targetClass="local.mtgassistantgateway.app.MainActivity">
            <extra android:name="page" android:value="decks" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="page_scan"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_scan"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="local.mtgassistantgateway.app.OPEN_PAGE"
            android:targetPackage="local.mtgassistantgateway.app"
            android:targetClass="local.mtgassistantgateway.app.MainActivity">
            <extra android:name="page" android:value="scan" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="page_proposals"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_proposals">
        <intent
            android:action="local.mtgassistantgateway.app.OPEN_PAGE"
            android:targetPackage="local.mtgassistantgateway.app"
            android:targetClass="local.mtgassistantgateway.app.MainActivity">
            <extra android:name="page" android:value="proposals" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="page_reports"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_reports">
        <intent
            android:action="local.mtgassistantgateway.app.OPEN_PAGE"
            android:targetPackage="local.mtgassistantgateway.app"
            android:targetClass="local.mtgassistantgateway.app.MainActivity">
            <extra android:name="page" android:value="reports" />
        </intent>
    </shortcut>
</shortcuts>
