        <path android:strokeColor="#ffffff" android:strokeWidth="3"
            android:pathData="M36,26 h36 a4,4 0 0 1 4,4 v48 a4,4 0 0 1 -4,4 h-36 a4,4 0 0 1 -4,-4 v-48 a4,4 0 0 1 4,-4 z" />
        <path android:fillColor="#ffffff"
            android:pathData="M54,40 l10,14 l-10,14 l-10,-14 z" />
