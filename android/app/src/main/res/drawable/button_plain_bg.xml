<?xml version="1.0" encoding="utf-8"?>
<!-- The pages' plain (outline) button, for the camera sheet: 3dp radius, 1dp border in the muted
     text colour, no fill; a light ripple while pressed; a fainter border while disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_dark">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/cam_border_disabled" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/cam_text_muted" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
