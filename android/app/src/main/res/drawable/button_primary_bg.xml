<?xml version="1.0" encoding="utf-8"?>
<!-- The pages' orange primary button (phatButton): 3dp radius, no border. A dark ripple while
     pressed; a grey fill (with the muted text from color/button_primary_text) while disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_accent">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_2" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
