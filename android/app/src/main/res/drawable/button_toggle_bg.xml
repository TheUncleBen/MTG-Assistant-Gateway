<?xml version="1.0" encoding="utf-8"?>
<!-- The camera sheet's Torch and Auto toggles: the plain outline while off, the orange fill while
     on (the same change of shape the pages' pressed toggles make, so the state is not colour alone). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_dark">
    <item>
        <selector>
            <item android:state_checked="true" android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_2" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/cam_border_disabled" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/cam_text_muted" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
