<?xml version="1.0" encoding="utf-8"?>
<!-- The round capture button, as the Scan page draws it: an orange disc inside an orange ring,
     a dark ripple while pressed, faded while the camera is not ready. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_accent">
    <item>
        <selector>
            <item android:state_enabled="false">
                <layer-list>
                    <item>
                        <shape android:shape="oval">
                            <stroke android:width="3dp" android:color="@color/surface_2" />
                        </shape>
                    </item>
                    <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                        <shape android:shape="oval">
                            <solid android:color="@color/surface_2" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="oval">
                            <stroke android:width="3dp" android:color="@color/accent" />
                        </shape>
                    </item>
                    <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                        <shape android:shape="oval">
                            <solid android:color="@color/accent" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
