# Settings for deploy/compose/docker-compose.yml.
#
# Copy to .env next to docker-compose.yml, change the REQUIRED lines, then
# `docker compose up -d`. Walkthrough: docs/DEPLOY-COMPOSE.md.
#
# No secrets go in here. They're files in ./secrets/ (run ./make-secrets.sh).
# Every value below is an example placeholder.

# --- Public address and sign-in ---------------------------------------------
# REQUIRED. The gateway's public https address behind your reverse proxy. No path.
MTG_PUBLIC_URL=https://mtg.example.com
# REQUIRED. Your identity provider's issuer URL (the "issuer" in its
# /.well-known/openid-configuration). Authentik example:
MTG_OIDC_ISSUER=https://auth.example.com/application/o/mtg-gateway/
# REQUIRED. Client ID of the confidential OIDC client you made for the gateway.
MTG_OIDC_CLIENT_ID=paste-client-id-here
# REQUIRED. Only members of this group get in, spelled exactly as your identity
# provider sends it in its groups claim (case-sensitive). The gateway won't
# start with it empty unless MTG_ALLOW_ANY_IDP_USER=true (then anyone your
# identity provider lets through gets in).
MTG_REQUIRED_GROUP=MTG Assistant Gateway Users
MTG_ALLOW_ANY_IDP_USER=false
# Optional: members of this group also get the /admin page (users, activity,
# metrics). Empty = no admin page.
MTG_ADMIN_GROUP=
# Optional, for identity providers other than Authentik (docs/IDP-OTHERS.md):
# where the group list is in the ID token (e.g. realm_access.roles for Keycloak),
# and how the client secret is sent (client_secret_post or client_secret_basic).
# Empty = groups and client_secret_post.
MTG_OIDC_GROUPS_CLAIM=
# Only after moving the identity provider to a new address: the old issuer
# URL(s), comma separated (docs/DEPLOY.md).
MTG_OIDC_PREVIOUS_ISSUERS=
MTG_OIDC_TOKEN_AUTH_METHOD=
# Optional: the name shown on the pages and to assistants.
MTG_SERVER_NAME=
# Scopes asked of the identity provider. Some need "groups" added to send
# group membership (Authelia, Pocket ID, Kanidm: docs/IDP-OTHERS.md).
# Keep offline_access: the provider's refresh token lets the gateway
# check on every request that the person is still in MTG_REQUIRED_GROUP. In
# Authentik, add the "OpenID 'offline_access'" scope mapping to the provider,
# or members have to sign in again every hour (docs/IDP-AUTHENTIK.md).
MTG_OIDC_SCOPES=openid profile email offline_access

# --- Images ------------------------------------------------------------------
MTG_IMAGE=ghcr.io/theuncleben/mtg-assistant-gateway
# latest follows main (every new version). To stay on one version, pin it instead, for
# example MTG_TAG=0.6.2 (git tag v0.6.2 = image 0.6.2). See docs/VERSIONS.md.
MTG_TAG=latest
MF_IMAGE=ghcr.io/theuncleben/mtg-assistant-mysticforge
MF_TAG=1.3.2-mag2

# --- Where it listens on this machine ----------------------------------------
# Your reverse proxy forwards https://mtg.example.com to this address.
# 127.0.0.1 keeps it off the network; use 0.0.0.0 only if the proxy is on
# another machine, and restrict it there: Docker's published ports bypass
# ufw/firewalld input rules, so filter in the DOCKER-USER chain.
MTG_HTTP_BIND=127.0.0.1
MTG_HTTP_PORT=8080

# --- Storage and limits ---------------------------------------------------------
# Folders on this machine's local disk (not NFS/SMB; SQLite needs local disk).
# Relative paths are relative to this folder. Create them and chown them to
# PUID:PGID before the first start.
MTG_DATA_DIR=./data
MTG_BACKUP_DIR=./backups
MTG_SECRETS_DIR=./secrets
MTG_BACKUP_HOUR_UTC=3
MTG_BACKUP_KEEP_DAYS=14
MTG_MEMORY_LIMIT=256M
MF_MEMORY_LIMIT=512M

# --- Standard container settings ---------------------------------------------
# User and group that own the folders above (run `id` to see yours).
PUID=1000
PGID=1000
TIMEZONE=UTC
MTG_LOG_LEVEL=INFO

# --- Deck edits on Archidekt ---------------------------------------------------
# true = approved proposals change Archidekt (a snapshot and a backup copy of the
# deck come first). false = proposals can be made and reviewed, nothing is ever
# applied. Make your first edit on a deck you don't care about.
MTG_WRITES_ENABLED=true
# false (recommended) = only the member's own click on Apply on the review page
# applies a change; the assistant gets the review link instead.
# true = the assistant may apply after the user says yes in chat. Weaker: text the
# assistant reads (deck descriptions, card notes, tool results) could trick it
# into applying its own proposal once the minimum wait below has passed.
MTG_APPLY_VIA_MCP=false
MTG_APPLY_MIN_AGE_SECONDS=15
MTG_ARCHIDEKT_BACKUPS=true
MTG_ARCHIDEKT_BACKUP_FOLDER=MTG Gateway backups

# --- Sessions and tokens (seconds; shorter is stricter) ------------------------
MTG_ACCESS_TOKEN_TTL=3600
MTG_REFRESH_TOKEN_TTL=2592000
MTG_BROWSER_SESSION_TTL=7200
MTG_REAUTH_INTERVAL=604800
# How long (0 to 60 seconds) one answer from the identity provider about a
# person's group membership is reused; also the longest a removed member keeps
# access. 0 asks on every request.
MTG_MEMBERSHIP_CHECK_TTL=5
# Archidekt work one member may start per 10 minutes (10 to 100000).
MTG_ARCHIDEKT_CALLS_PER_10_MIN=120

# --- Which AI clients may connect -----------------------------------------------
MTG_CIMD_ENABLED=true
# Empty = any https host. See docs/OPERATIONS.md before you narrow it.
MTG_CIMD_ALLOWED_HOSTS=

# --- Network trust ---------------------------------------------------------------
# IPs or CIDRs whose X-Forwarded-* headers are trusted. Empty = private networks
# and loopback, which covers a proxy on this machine or in a container.
MTG_TRUSTED_PROXIES=
# Host headers /mcp accepts. Empty = the host in MTG_PUBLIC_URL. Only needed if
# your proxy can't pass the original Host header through.
MTG_ALLOWED_HOSTS=

# --- Optional: the proxy overrides in deploy/proxy/ ---------------------------
# Caddy (compose.caddy.yml): path to the Caddyfile, relative to this folder.
#CADDYFILE=../proxy/caddy/Caddyfile
# Traefik (compose.traefik.yml):
#MTG_HOSTNAME=mtg.example.com
#TRAEFIK_NETWORK=proxy
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
