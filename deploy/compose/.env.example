# Settings for deploy/compose/docker-compose.yml. Copy to .env next to it.
# Walkthrough: docs/DEPLOY-COMPOSE.md. Fill in the REQUIRED lines; the rest can stay.
# Secrets are files in ./secrets/ (run ./make-secrets.sh), never in this file.
# Everything else is on the gateway's Settings page (/admin/settings).

# --- Address and sign-in (REQUIRED) ---
# The gateway's https address behind your reverse proxy, no path.
MTG_PUBLIC_URL=https://mtg.example.com
# From your identity provider: the issuer URL and the client ID.
MTG_OIDC_ISSUER=https://auth.example.com/application/o/mtg-gateway/
MTG_OIDC_CLIENT_ID=paste-client-id-here
# Only members of this group get in (exact spelling, case-sensitive).
MTG_REQUIRED_GROUP=MTG Assistant Gateway Users
# Members of this group also get the admin pages. Empty = no admin pages.
MTG_ADMIN_GROUP=

# --- Where it runs ---
# Your reverse proxy forwards to this address. 127.0.0.1 keeps it off the network.
MTG_HTTP_BIND=127.0.0.1
MTG_HTTP_PORT=8080
# Folders on local disk (not NFS), owned by PUID:PGID (run `id` to see yours).
MTG_DATA_DIR=./data
MTG_BACKUP_DIR=./backups
PUID=1000
PGID=1000
# The Docker network a proxy container joins.
MTG_NETWORK_NAME=mtg-gateway

# --- Optional ---
# latest = every new version; a version such as 0.7.45 stays on it.
MTG_TAG=latest
TIMEZONE=UTC
# A second folder every backup is copied to, such as another disk. Empty = none.
MTG_BACKUP_COPY_DIR=
# Gateway memory limit.
MTG_MEMORY_LIMIT=256M

# --- Forge simulations ---
# 1 = on, 0 = off. Forge's memory and CPU limit set how many games run at once.
FORGE_REPLICAS=1
FORGE_MEMORY_LIMIT=1536M
FORGE_CPUS=2

# --- Features (all on) ---
# Empty = on, switchable on the Settings page. false (0 for the deck check) turns it off;
# any value locks its Settings page row.
# Deck edits reaching Archidekt (false = proposals only; not on the page).
MTG_WRITES_ENABLED=true
# Watchlists and price alerts.
MTG_WATCHLISTS_ENABLED=
# A backup copy on Archidekt before each edit.
MTG_ARCHIDEKT_BACKUPS=
# Approve buttons on the change cards in Claude and ChatGPT.
MTG_APPLY_IN_CHAT=
# The card scanner's artwork check (picks the printing).
MTG_SCAN_ART_ENABLED=
# The twice-daily new-version check.
MTG_UPDATE_CHECK=
# Minutes between background deck-change checks, 0 = off. Empty = 30.
MTG_DECK_SYNC_MINUTES=

# --- Security (leave empty for the defaults) ---
# Reverse proxy IPs or CIDRs whose X-Forwarded headers are trusted. Empty = private networks.
MTG_TRUSTED_PROXIES=
# Assistant clients that identify by a published address (Claude, ChatGPT), and the hosts
# allowed to. Empty hosts = any https host.
MTG_CIMD_ENABLED=true
MTG_CIMD_ALLOWED_HOSTS=
# Lifetimes in seconds: assistant access token, assistant refresh token, browser session,
# forced sign-in again, and how long a group-membership answer is reused.
MTG_ACCESS_TOKEN_TTL=3600
MTG_REFRESH_TOKEN_TTL=2592000
MTG_BROWSER_SESSION_TTL=604800
MTG_REAUTH_INTERVAL=604800
MTG_MEMBERSHIP_CHECK_TTL=5
# true = anyone your identity provider signs in gets in, with no group needed.
MTG_ALLOW_ANY_IDP_USER=false

# --- Other identity providers (docs/IDP-OTHERS.md) ---
# Where the group list is in the ID token (Keycloak: realm_access.roles). Empty = groups.
MTG_OIDC_GROUPS_CLAIM=
# Scopes to ask for; add groups if your provider needs it (Authelia, Pocket ID).
MTG_OIDC_SCOPES=openid profile email offline_access
# How the client secret is sent: client_secret_post or client_secret_basic. Empty = post.
MTG_OIDC_TOKEN_AUTH_METHOD=
# Only after moving the identity provider: its old issuer URL(s), comma separated.
MTG_OIDC_PREVIOUS_ISSUERS=

# --- Only with the Traefik override (deploy/proxy/traefik/) ---
# The gateway's host name, the network Traefik is on, its certificate resolver and entrypoint.
#MTG_HOSTNAME=mtg.example.com
#TRAEFIK_NETWORK=proxy
#TRAEFIK_CERTRESOLVER=letsencrypt
#TRAEFIK_ENTRYPOINT=websecure
