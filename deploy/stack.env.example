# Environment variables for deploy/portainer-stack.yml.
#
# How to use: copy this file, change the lines marked REQUIRED, then load it in
# Portainer's stack editor (Environment variables > Load variables from .env file,
# or Advanced mode and paste), or export it before `docker stack deploy`.
# Full walkthrough: docs/DEPLOY.md, step 6. Single machine without Swarm:
# deploy/compose/ and docs/DEPLOY-COMPOSE.md instead.
#
# No secrets go in here. The three secrets (mtg_fernet_key, mtg_session_secret,
# mtg_oidc_client_secret) are Docker Swarm secrets: docs/DEPLOY.md, step 4.
# Values are example placeholders; nothing below is a real host or account.

# --- Images ------------------------------------------------------------------
# Private GHCR packages need a Portainer registry login with read:packages (step 5).
MTG_IMAGE=ghcr.io/theuncleben/mtg-assistant-gateway
# latest follows main (every new version). To stay on one version, pin it instead, for
# example MTG_TAG=0.5.0 (git tag v0.5.0 = image 0.5.0). See docs/VERSIONS.md.
MTG_TAG=latest
MF_IMAGE=ghcr.io/theuncleben/mtg-assistant-mysticforge
MF_TAG=1.3.2-mag2

# --- Public address and sign-in ---------------------------------------------
# REQUIRED. The gateway's public https address behind your reverse proxy. No path.
MTG_PUBLIC_URL=https://mtg.example.com
# REQUIRED. Your identity provider's issuer URL. Authentik: provider page >
# "OpenID Configuration Issuer". Others: docs/IDP-OTHERS.md.
MTG_OIDC_ISSUER=https://auth.example.com/application/o/mtg-gateway/
# REQUIRED. The OIDC client's Client ID. (The client secret is a Docker secret.)
MTG_OIDC_CLIENT_ID=paste-client-id-here
# REQUIRED. Only members of this group get in, spelled exactly as your identity
# provider sends it in its groups claim (case-sensitive). The gateway won't
# start with it empty unless MTG_ALLOW_ANY_IDP_USER=true (then anyone your
# identity provider lets through gets in).
MTG_REQUIRED_GROUP=MTG Assistant Gateway Users
MTG_ALLOW_ANY_IDP_USER=false
# Optional: members of this group also get the /admin page (users, activity,
# metrics). Empty = no admin page.
MTG_ADMIN_GROUP=
# Optional, for identity providers other than Authentik (docs/IDP-OTHERS.md):
# where the group list is in the ID token (e.g. realm_access.roles for Keycloak),
# and how the client secret is sent (client_secret_post or client_secret_basic).
# Empty = groups and client_secret_post.
MTG_OIDC_GROUPS_CLAIM=
MTG_OIDC_TOKEN_AUTH_METHOD=
# Optional: the name shown on the pages and to assistants.
MTG_SERVER_NAME=

# --- Placement, storage and limits --------------------------------------------
# REQUIRED. Hostname of the Swarm node that keeps the gateway data (docker node ls).
MTG_NODE=swarm-node-1
# REQUIRED. Hostname of the node that runs Mystic Forge (can be the same node).
MF_NODE=swarm-node-1
# REQUIRED. Folders on MTG_NODE's local disk (not CephFS/NFS; SQLite needs local disk).
# Create them first and chown them to PUID:PGID (step 2).
MTG_DATA_DIR=/srv/mtg-gateway/data
MTG_BACKUP_DIR=/srv/mtg-gateway/backups
# Nightly database backup: hour (UTC) and days kept.
MTG_BACKUP_HOUR_UTC=3
MTG_BACKUP_KEEP_DAYS=14
# Overlay network from step 1 (created once, also attached to your reverse proxy).
# Mystic Forge is not on it: the stack gives it a private network of its own.
# Must already exist and match exactly: names are case-sensitive (mtg-gateway is not MTG-Gateway).
MTG_NETWORK_NAME=mtg-gateway
MTG_MEMORY_LIMIT=256M
MF_MEMORY_LIMIT=512M

# --- Standard container settings ---------------------------------------------
# REQUIRED. User and group that own the folders above.
PUID=1000
PGID=1000
TIMEZONE=UTC
MTG_LOG_LEVEL=INFO

# --- Deck edits on Archidekt ---------------------------------------------------
# false = proposals can be made and reviewed, nothing is ever applied (safest).
# true = approved proposals change Archidekt. Verified live on a test account;
# still make your own first edit on a deck you don't care about.
MTG_WRITES_ENABLED=true
# false (recommended) = only the member's own click on Apply on the review page
# applies a change; the assistant gets the review link instead.
# true = the assistant may apply after the user says yes in chat (a snapshot is
# taken first). Weaker: text the assistant reads (deck descriptions, card notes,
# tool results) could trick it into applying its own proposal once the minimum
# wait below has passed. Turn it on only if you accept that.
MTG_APPLY_VIA_MCP=false
# The assistant can't apply a proposal younger than this many seconds (0 turns it off).
MTG_APPLY_MIN_AGE_SECONDS=15
# Before every applied edit, keep a private copy of the deck in this Archidekt folder
# (kept off the assistant's deck list). If the copy fails, the edit doesn't happen.
MTG_ARCHIDEKT_BACKUPS=true
MTG_ARCHIDEKT_BACKUP_FOLDER=MTG Gateway backups

# --- Sessions and tokens (seconds; shorter is stricter) ------------------------
# Assistant access token lifetime (60 to 86400).
MTG_ACCESS_TOKEN_TTL=3600
# Assistant refresh token lifetime (3600 to 31536000; default 30 days).
MTG_REFRESH_TOKEN_TTL=2592000
# Browser session for /account and review pages (300 to 86400).
MTG_BROWSER_SESSION_TTL=7200
# Assistants must sign in again after this long. Group membership itself is
# checked live with the identity provider on every request, not only here.
MTG_REAUTH_INTERVAL=604800

# --- Which AI clients may connect -----------------------------------------------
# Clients that identify by a Client ID Metadata Document URL ("published identity";
# Claude and, per OpenAI, ChatGPT). false = only self-registering clients.
MTG_CIMD_ENABLED=true
# Empty = any https host. Leave it empty unless you list EVERY client's host
# (copy them from the cimd_accepted audit entries); listing only Claude's locks out ChatGPT.
MTG_CIMD_ALLOWED_HOSTS=

# --- Network trust ---------------------------------------------------------------
# IPs or CIDRs (comma-separated) whose X-Forwarded-* headers are trusted. Empty =
# private networks. Recommended: narrow it to your reverse proxy's address on the
# overlay network, or the network's subnet (docs/DEPLOY.md, step 7).
MTG_TRUSTED_PROXIES=

# --- Leave these as they are -------------------------------------------------------
# Internal Mystic Forge MCP endpoint (service name on the stack network).
MTG_MYSTIC_FORGE_URL=http://mtg-assistant-mysticforge:8000/mcp
# Base URL Mystic Forge prints in links. Its own default is the upstream author's site.
MF_PUBLIC_BASE=http://mtg-assistant-mysticforge:8000
# Archidekt API base. Only the end-to-end tests change it (to a local mock).
MTG_ARCHIDEKT_BASE=https://archidekt.com/api
# Seconds between Scryfall lookups for card scanning (0.1 to 5). Lower risks rate limits.
MTG_SCRYFALL_LOOKUP_INTERVAL=0.5
