# Environment variables for deploy/portainer-stack.yml.
#
# How to use: copy this file, change the lines marked REQUIRED, then load it in
# Portainer's stack editor (Environment variables > Load variables from .env file,
# or Advanced mode and paste), or export it before `docker stack deploy`.
# Full walkthrough: docs/DEPLOY.md, step 6. Single machine without Swarm:
# deploy/compose/ and docs/DEPLOY-COMPOSE.md instead.
#
# No secrets go in here. The five secrets (mtg_fernet_key, mtg_session_secret,
# mtg_oidc_client_secret, mtg_ntfy_token, mtg_authentik_api_token) are Docker Swarm secrets:
# docs/DEPLOY.md, step 4.
# Values are example placeholders; nothing below is a real host or account.
#
# Every variable the stack file reads is listed here, and each one says whether it is REQUIRED
# or Optional. An Optional line shows the value used when it isn't set (except
# MTG_WRITES_ENABLED, whose note says why). A line starting "#" is not set. "On the Settings
# page if not set here": while it isn't set here, an admin changes it on the gateway's Settings
# page (/admin/settings); remove the "# " to set it here instead, and the Settings page then
# shows it greyed out with its value and can't change it. "Not on the Settings page": only this
# file changes it. A range shown here is what this file accepts. For Archidekt and Scryfall
# pacing, deck sync, watchlist sizes and the artwork image fetches, the Settings page can only be
# gentler than the default.
# A few exist only with Swarm, so the Compose example doesn't have them: MTG_NODE, MF_NODE,
# FORGE_REPLICAS and FORGE_NODE.

# --- Images -----------------------------------------------------------------------------------
# Optional. Not on the Settings page. The images are public on GitHub's container registry
# (ghcr.io): no registry login is needed.
MTG_IMAGE=ghcr.io/theuncleben/mtg-assistant-gateway
# Optional. Not on the Settings page. latest follows main (every new version). To stay on one
# version, pin it instead, for example MTG_TAG=0.6.6 (git tag v0.6.6 = image 0.6.6). See
# docs/VERSIONS.md.
MTG_TAG=latest
# Optional. Not on the Settings page. The Mystic Forge image and version.
MF_IMAGE=ghcr.io/theuncleben/mtg-assistant-mysticforge
MF_TAG=1.3.2-mag5

# --- Server Settings --------------------------------------------------------------------------
# REQUIRED. The gateway's public https address behind your reverse proxy. No path.
MTG_PUBLIC_URL=https://mtg.example.com
# Optional. On the Settings page if not set here. The name shown on the pages and to assistants.
# MTG_SERVER_NAME=MTG Assistant Gateway
# Optional. On the Settings page if not set here. The ChatGPT connector name, when it should
# differ (docs/DEPLOY.md).
# MTG_CHATGPT_NAME=
# Optional. On the Settings page if not set here. Deck sync: minutes between background checks
# of Archidekt for members with proposals waiting (opening the app checks too). Read-only: a
# check reads the member's deck list (one request per 50 decks, at most 4) and, in full, only
# decks with proposals waiting (at most 5). 0 = off.
# MTG_DECK_SYNC_MINUTES=30

# --- Placement, storage and limits ------------------------------------------------------------
# REQUIRED. Hostname of the Swarm node that keeps the gateway data (docker node ls).
MTG_NODE=swarm-node-1
# REQUIRED. Hostname of the node that runs Mystic Forge (can be the same node).
MF_NODE=swarm-node-1
# REQUIRED. Folders on MTG_NODE's local disk (not CephFS/NFS; SQLite needs local disk).
# Create them first and chown them to PUID:PGID (step 2).
MTG_DATA_DIR=/srv/mtg-gateway/data
MTG_BACKUP_DIR=/srv/mtg-gateway/backups
# Optional. Not on the Settings page. A second folder every backup is also copied to, for
# example shared storage that every node mounts at the same path (such as
# /path/to/shared/backups), so a backup survives losing the node MTG_NODE names. It must already
# exist there. Not set: no copies.
#MTG_BACKUP_COPY_DIR=
# Optional. On the Settings page if not set here. Nightly database backup: hour (UTC) and days
# kept. The copies saved before database upgrades are deleted after those days too.
# MTG_BACKUP_HOUR_UTC=3
# MTG_BACKUP_KEEP_DAYS=14
# Optional. Not on the Settings page. Overlay network from step 1 (created once, also attached
# to your reverse proxy). Mystic Forge is not on it: the stack gives it a private network of its
# own. Must already exist and match exactly: names are case-sensitive (mtg-gateway is not
# MTG-Gateway).
MTG_NETWORK_NAME=mtg-gateway
# Optional. Not on the Settings page. Memory limits of the gateway and Mystic Forge.
MTG_MEMORY_LIMIT=256M
MF_MEMORY_LIMIT=512M

# --- Standard container settings --------------------------------------------------------------
# REQUIRED. User and group that own the folders above.
PUID=1000
PGID=1000
# Optional. Not on the Settings page. The containers' time zone.
TIMEZONE=UTC
# Optional. On the Settings page if not set here. DEBUG, INFO, WARNING, ERROR or CRITICAL.
# MTG_LOG_LEVEL=INFO

# --- OIDC and sign-in -------------------------------------------------------------------------
# REQUIRED. Your identity provider's issuer URL. Authentik: provider page >
# "OpenID Configuration Issuer". Others: docs/IDP-OTHERS.md.
MTG_OIDC_ISSUER=https://auth.example.com/application/o/mtg-gateway/
# REQUIRED. The OIDC client's Client ID. (The client secret is a Docker secret.)
MTG_OIDC_CLIENT_ID=paste-client-id-here
# REQUIRED, unless MTG_ALLOW_ANY_IDP_USER=true. Only members of this group get in, spelled
# exactly as your identity provider sends it in its groups claim (case-sensitive). The gateway
# won't start with it empty unless MTG_ALLOW_ANY_IDP_USER=true (then anyone your identity
# provider lets through gets in).
MTG_REQUIRED_GROUP=MTG Assistant Gateway Users
# Optional. Not on the Settings page. See MTG_REQUIRED_GROUP.
MTG_ALLOW_ANY_IDP_USER=false
# Optional. Not on the Settings page. Members of this group also get the /admin page (users,
# activity, metrics). Empty = no admin page.
MTG_ADMIN_GROUP=
# Optional. Not on the Settings page. Authentik only: the hourly clean-up deletes the stored
# Archidekt session of anyone no longer in MTG_REQUIRED_GROUP or MTG_ADMIN_GROUP. It reads its
# token from the mtg_authentik_api_token secret, where the word off turns it off
# (docs/IDP-AUTHENTIK.md). Leave this line commented out.
# MTG_AUTHENTIK_API_TOKEN_FILE=/run/secrets/mtg_authentik_api_token
# Optional. Not on the Settings page. Only if Authentik's API is not at the issuer's address
# (https only).
MTG_AUTHENTIK_API_URL=
# Optional. Not on the Settings page. For identity providers other than Authentik
# (docs/IDP-OTHERS.md): where the group list is in the ID token (e.g. realm_access.roles for
# Keycloak), and how the client secret is sent (client_secret_post or client_secret_basic).
# Empty = groups and client_secret_post.
MTG_OIDC_GROUPS_CLAIM=
MTG_OIDC_TOKEN_AUTH_METHOD=
# Optional. Not on the Settings page. Only after moving the identity provider to a new address:
# the old issuer URL(s), comma separated (docs/DEPLOY.md).
MTG_OIDC_PREVIOUS_ISSUERS=
# Optional. Not on the Settings page. The scopes the gateway asks for. Keep offline_access: the
# provider's refresh token lets the gateway check, as requests come in, that the person is still
# in MTG_REQUIRED_GROUP (docs/IDP-AUTHENTIK.md).
#MTG_OIDC_SCOPES=openid profile email offline_access

# --- NTFY and Watchlist Settings --------------------------------------------------------------
# Notifications to the members' Android app use the stack's own ntfy server and the
# mtg_ntfy_token secret (docs/DEPLOY.md, "Notifications on members' phones"); nothing here needs
# setting for them.
# Optional. Not on the Settings page. The ntfy image (pinned by digest) and its memory limit.
#NTFY_IMAGE=binwiederhier/ntfy:v2.31.1@sha256:91bb7fa607b02006c119bb4a31032923b414a713a032ecb40f0c5d6bfd5b7e40
#NTFY_MEMORY_LIMIT=128M
# Optional. Not on the Settings page. Leave as is: the stack's own ntfy server, and the file the
# mtg_ntfy_token secret is mounted at.
#MTG_NTFY_URL=http://mtg-assistant-ntfy:8080
#MTG_NTFY_TOKEN_FILE=/run/secrets/mtg_ntfy_token
# Optional. On the Settings page if not set here. Watchlists and price history, off by default.
# true adds the Watchlist pages, the card viewer's price buttons, the five watch tools and the
# daily price check; false keeps stored watches but hides them.
# MTG_WATCHLISTS_ENABLED=false
# Optional. On the Settings page if not set here. Limits per member, days of prices kept, hour
# (UTC) of the daily check.
# MTG_WATCH_MAX_CARDS=200
# MTG_WATCH_MAX_DECKS=10
# MTG_PRICE_HISTORY_DAYS=365
# MTG_PRICE_HOUR_UTC=6

# --- Deck edits on Archidekt ------------------------------------------------------------------
# Optional. Not on the Settings page. Not set, it is false. true = approved proposals change
# Archidekt. false stops all writes: proposals can still be made and reviewed, but nothing is
# applied. Make your first edit on a deck you don't care about.
MTG_WRITES_ENABLED=true
# Optional. On the Settings page if not set here. Approval modes. Every member picks their own on
# the Account page: manual (ask me every time, the default), semi (low-risk changes, such as a
# small edit or a private copy of a deck, apply without asking) or auto (most changes apply
# without asking, but some still wait for the member). This is the mode of a member who has not
# chosen yet; leave it manual.
# MTG_APPROVAL_MODE_DEFAULT=manual
# Optional. On the Settings page if not set here. The highest mode members may choose (manual,
# semi or auto). auto = no cap.
# MTG_APPROVAL_MODE_MAX=auto
# Optional. On the Settings page if not set here. How many review rows an edit may have and still
# count as low risk in semi mode.
# MTG_AUTO_APPLY_MAX_ROWS=5
# Optional. On the Settings page if not set here. In auto mode, a deck or collection edit with
# more card rows than this waits for the member's press (1 to 100).
# MTG_AUTO_BIG_EDIT_ROWS=20
# Optional. On the Settings page if not set here. Days a waiting change stays open for approval
# (1 to 30).
# MTG_PROPOSAL_EXPIRY_DAYS=7
# Optional. On the Settings page if not set here. The Approve/Reject card an AI app shows next to
# a proposal in the chat (Claude on web, desktop and phone; ChatGPT). Only the card's one-time
# code can apply, never the assistant. false leaves only the review page.
# MTG_APPLY_IN_CHAT=true
# Optional. On the Settings page if not set here. Twice a day the gateway asks GitHub whether a
# newer release is out and, if so, shows its admins a notice with the update steps. It never
# updates itself. false turns the check off.
# MTG_UPDATE_CHECK=true
# Optional. On the Settings page if not set here. Before every applied edit, keep a private copy
# of the deck in this Archidekt folder (kept off the assistant's deck list). If the copy fails,
# the edit doesn't happen.
# MTG_ARCHIDEKT_BACKUPS=true
# Optional. Not on the Settings page. The Archidekt folder the backup copies go in.
MTG_ARCHIDEKT_BACKUP_FOLDER=MTG Gateway backups
# Optional. On the Settings page if not set here. Backup copies kept per deck in that folder (1
# to 50), whether the deck editor's "Also keep a backup copy on Archidekt" box starts ticked, and
# restore points kept per deck on the gateway for History > Restore (5 to 100).
# MTG_ARCHIDEKT_BACKUP_COPIES=10
# MTG_ARCHIDEKT_BACKUP_BOX_DEFAULT=false
# MTG_SNAPSHOTS_PER_DECK=25

# --- Forge simulations (optional, off by default) ---------------------------------------------
# Forge plays real games for run_deck_report. To turn it on: FORGE_REPLICAS=1, FORGE_NODE=<a node
# with spare memory>, MTG_FORGE_URL=http://mtg-assistant-forge:8000. Java runs only during a
# simulation, limited by FORGE_MEMORY_LIMIT and FORGE_CPUS; MTG_FORGE_GAMES games per report.
# Optional. Not on the Settings page. 0 = Forge off, 1 = on.
FORGE_REPLICAS=0
# REQUIRED when FORGE_REPLICAS=1. The node that runs Forge.
FORGE_NODE=
# Optional. Not on the Settings page. Empty = Forge off; http://mtg-assistant-forge:8000 = on.
MTG_FORGE_URL=
# Optional. On the Settings page if not set here. Forge games per deck report (1 to 50), and how
# many of them the gateway asks Forge to play at once (1 to 16; FORGE_MAX_PARALLEL below caps it
# for all runs together).
# MTG_FORGE_GAMES=4
# MTG_FORGE_PARALLEL_GAMES=4
# Optional. Not on the Settings page. The Forge image and version. The stack file names one exact
# Forge version, which changes only when you deploy a newer stack file. Leave these commented out
# to use the stack file's version. Uncomment FORGE_TAG only to pin Forge on purpose: it then
# stays on that version even when the stack file moves on.
#FORGE_IMAGE=ghcr.io/theuncleben/mtg-assistant-forge
#FORGE_TAG=2.0.15-mag5
# Optional. Not on the Settings page. Java's memory for each Forge game.
#FORGE_XMX=1g
# Optional. Not on the Settings page. Forge's memory and CPU limits. The memory limit is also
# passed to Forge as FORGE_MEMORY_BUDGET, which sizes the games at once where Docker can't cap
# memory (Raspberry Pi OS by default); not a hard limit as Docker's is.
#FORGE_MEMORY_LIMIT=1536M
#FORGE_CPUS=2
# Optional. Not on the Settings page. Seconds before Forge calls one game a draw (Forge's own
# default, 120, is too short on a Pi).
#FORGE_GAME_SECONDS=240
# Optional. Not on the Settings page. Forge games played at once at most (1 to 16). Empty: as many
# as the container's CPUs and memory fit, about 2 CPUs and 1.2 GB a game, so 1 inside the default
# FORGE_CPUS and FORGE_MEMORY_LIMIT. Set it by hand only to a number the machine holds
# (docs/DEPLOY.md, "Forge simulations", has measurements). MTG_FORGE_PARALLEL_GAMES can ask for
# fewer, never more.
#FORGE_MAX_PARALLEL=
# Optional. Not on the Settings page. Each Forge game's extra Java memory for loaded code (on top
# of FORGE_XMX), and how readily the kernel stops a Forge game when the machine runs out of
# memory: 1 to 1000 (1000: Forge goes first; 0 turns this off).
#FORGE_MAX_METASPACE=256m
#FORGE_OOM_SCORE_ADJ=1000
# Optional. Not on the Settings page. The most games Forge accepts in one request (it refuses a
# run that asks for more). Each report run and each Play more games round asks for at most
# MTG_FORGE_GAMES, so keep this at or above that.
#FORGE_MAX_GAMES=50

# --- Sessions and tokens (seconds; shorter is stricter) ---------------------------------------
# Optional. Not on the Settings page. Assistant access token lifetime (60 to 86400).
MTG_ACCESS_TOKEN_TTL=3600
# Optional. Not on the Settings page. Assistant refresh token lifetime (3600 to 31536000; default
# 30 days).
MTG_REFRESH_TOKEN_TTL=2592000
# Optional. Not on the Settings page. Browser session for /account and review pages (300 to
# 86400).
MTG_BROWSER_SESSION_TTL=7200
# Optional. Not on the Settings page. Assistants must sign in again after this long. Group
# membership itself is checked live with the identity provider as requests come in (see
# MTG_MEMBERSHIP_CHECK_TTL).
MTG_REAUTH_INTERVAL=604800
# Optional. Not on the Settings page. How long (0 to 60 seconds) one answer from the identity
# provider about a person's group membership is reused; also the longest a removed member keeps
# access. 0 asks on every request.
MTG_MEMBERSHIP_CHECK_TTL=5
# Optional. On the Settings page if not set here. Archidekt work one member may start per 10
# minutes (10 to 100000).
# MTG_ARCHIDEKT_CALLS_PER_10_MIN=120
# Optional. On the Settings page if not set here. Gentle on Archidekt, for everyone together:
# requests at least this many seconds apart (0.25 to 10) and at most this many in any minute (1
# to 120).
# MTG_ARCHIDEKT_MIN_INTERVAL=1.0
# MTG_ARCHIDEKT_MAX_PER_MINUTE=30
# Optional. On the Settings page if not set here. Reads that time out or get a server error are
# retried this many times (0 to 4) after a random wait of up to BACKOFF_BASE x 2, 4... seconds
# (capped at 10).
# MTG_ARCHIDEKT_RETRIES=2
# MTG_ARCHIDEKT_BACKOFF_BASE=1.0
# Optional. On the Settings page if not set here. Seconds anonymous deck and search reads (0 to
# 900) and card lookups (0 to 86400) are reused; 0 turns that cache off.
# MTG_ARCHIDEKT_CACHE_SECONDS=60
# MTG_ARCHIDEKT_CARD_CACHE_SECONDS=3600

# --- Which AI clients may connect -------------------------------------------------------------
# Optional. Not on the Settings page. Clients that identify by a Client ID Metadata Document URL
# ("published identity"; Claude and, per OpenAI, ChatGPT). false = only self-registering clients.
MTG_CIMD_ENABLED=true
# Optional. Not on the Settings page. Empty = any https host. Leave it empty unless you list EVERY
# client's host (copy them from the cimd_accepted audit entries); listing only Claude's locks out
# ChatGPT.
MTG_CIMD_ALLOWED_HOSTS=

# --- Network trust ----------------------------------------------------------------------------
# Optional. Not on the Settings page. IPs or CIDRs (comma-separated) whose X-Forwarded-* headers
# are trusted. Empty = private networks. Recommended: narrow it to your reverse proxy's address
# on the overlay network, or the network's subnet (docs/DEPLOY.md, step 7).
MTG_TRUSTED_PROXIES=
# Optional. Not on the Settings page. Host headers /mcp accepts. Empty = the host in
# MTG_PUBLIC_URL. Only needed if your proxy can't pass the original Host header through.
#MTG_ALLOWED_HOSTS=

# --- Card scanning ----------------------------------------------------------------------------
# Optional. On the Settings page if not set here. Name matching: the lowest similarity at which a
# corrected name is accepted (0.3 to 1), the similarity accepted without a second lookup (0.3 to
# 1), and how close two candidates can be before the answer is "ambiguous" (0 to 0.5).
# MTG_SCAN_FUZZY_MIN_SIMILARITY=0.65
# MTG_SCAN_FUZZY_CONFIDENT_SIMILARITY=0.8
# MTG_SCAN_AMBIGUITY_MARGIN=0.05
# Optional. On the Settings page if not set here. Reading: the confidence a continuous-scan card
# needs to be added without a tap (0 to 100), and below which a continuous-scan title goes to the
# unidentified list without a lookup (0 to 100).
# MTG_SCAN_AUTO_ADD_CONFIDENCE=80.0
# MTG_SCAN_MIN_OCR_CONFIDENCE=50.0
# Optional. On the Settings page if not set here. The threshold for spotting the foil star on the
# collector line (0.01 to 0.9), and the share of blown-out pixels in the title that triggers the
# glare hint (0.005 to 0.9).
# MTG_SCAN_FOIL_STAR_INK_RATIO=0.09
# MTG_SCAN_GLARE_RATIO=0.08
# Optional. On the Settings page if not set here. The artwork check (docs/SCANNING.md): on or
# off, the largest difference that still counts as a match and the margin the best match must
# win by (each 0 to 1024), the newest printings learned per card (1 to 2000), seconds between
# image fetches (0.05 to 5), image fetches per hour (1 to 36000), cards whose learned printings
# are kept (1 to 100000), and days without a scan before a card's printings are dropped (1 to
# 3650). The Settings page can only make image fetches slower or fewer than the defaults (0.1
# seconds, 1500 an hour); to make them faster or more, set them here.
# MTG_SCAN_ART_ENABLED=true
# MTG_SCAN_ART_MAX_DISTANCE=380
# MTG_SCAN_ART_MIN_MARGIN=40
# MTG_SCAN_ART_MAX_PRINTINGS=250
# MTG_SCAN_ART_IMAGE_INTERVAL=0.1
# MTG_SCAN_ART_IMAGES_PER_HOUR=1500
# MTG_SCAN_ART_MAX_GALLERIES=500
# MTG_SCAN_ART_GALLERY_IDLE_DAYS=180

# --- Leave these as they are ------------------------------------------------------------------
# Optional. Not on the Settings page. Only for an Android app you build yourself
# (docs/ANDROID.md): its package ID, and the App Links statement list served at
# /.well-known/assetlinks.json, as one JSON list. Empty = an empty list.
#MTG_ANDROID_PACKAGE=local.mtgassistantgateway.app
#MTG_ANDROID_ASSETLINKS=
# Optional. Not on the Settings page. Only with a folder you mount into the gateway yourself: your
# own copy of the assistant plugin (docs/OPERATIONS.md) or of the Android app (docs/ANDROID.md).
# Not set: the copies in the image (/usr/share/mtg-gateway/plugin and /usr/share/mtg-gateway/app).
#MTG_PLUGIN_DIR=
#MTG_APP_DIR=
# Optional. Not on the Settings page. Internal Mystic Forge MCP endpoint (service name on the
# stack network).
#MTG_MYSTIC_FORGE_URL=http://mtg-assistant-mysticforge:8000/mcp
# Optional. Not on the Settings page. Base URL Mystic Forge prints in links. Not set, the stack
# file uses the value below (Mystic Forge's own default would be the upstream author's public site).
#MF_PUBLIC_BASE=http://mtg-assistant-mysticforge:8000
# Optional. Not on the Settings page. Archidekt API base. Only the end-to-end tests change it (to
# a local mock).
#MTG_ARCHIDEKT_BASE=https://archidekt.com/api
# Optional. On the Settings page if not set here. Seconds between Scryfall lookups for card
# scanning (0.1 to 5). Lower risks rate limits.
# MTG_SCRYFALL_LOOKUP_INTERVAL=0.5
